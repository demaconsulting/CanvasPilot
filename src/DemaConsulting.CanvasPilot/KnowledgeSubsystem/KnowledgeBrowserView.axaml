<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemaConsulting.CanvasPilot.KnowledgeSubsystem"
        x:Class="DemaConsulting.CanvasPilot.KnowledgeSubsystem.KnowledgeBrowserView"
        x:DataType="vm:KnowledgeBrowserViewModel"
        Title="{Binding Title}"
        Icon="avares://DemaConsulting.CanvasPilot/Assets/Icon.png"
        Width="1000"
        Height="700"
        MinWidth="620"
        MinHeight="400"
        Background="{DynamicResource CpSurfacePane}"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <!-- A card in a list shows as a flat button, so that it reads as a link; it gets a tint under the pointer and a focus ring from the keyboard -->
    <Style Selector="Button.card-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource CpRadiusRow}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.card-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CpAccentTintHover}" />
    </Style>
    <Style Selector="Button.card-link:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource CpFocusRing}" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="{DynamicResource CpFontSubtitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
      <Setter Property="Margin" Value="0,14,0,2" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="300,Auto,*">

    <!-- Two or more letters search the cards and show the hits in place of the tree -->
    <TextBox Name="SearchBox"
             Grid.Row="0"
             Grid.Column="0"
             Grid.ColumnSpan="3"
             Margin="16,16,16,12"
             AutomationProperties.AutomationId="KnowledgeSearchBox"
             AutomationProperties.Name="Search the cards"
             PlaceholderText="Search the cards (two or more letters)"
             Text="{Binding SearchText, Mode=TwoWay}" />

    <!-- The cards as a tree, or the hits of the search -->
    <Panel Grid.Row="1" Grid.Column="0" Margin="16,0,0,0">

      <TreeView Name="CardTree"
                AutomationProperties.AutomationId="KnowledgeCardTree"
                AutomationProperties.Name="Cards"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Nodes}"
                SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                IsVisible="{Binding !IsSearching}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:KnowledgeNodeViewModel">
            <Setter Property="Theme" Value="{DynamicResource ExplorerTreeViewItem}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="vm:KnowledgeNodeViewModel" ItemsSource="{Binding Children}">
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" ToolTip.Tip="{Binding Summary}" />
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsSearching}">
        <StackPanel>
          <TextBlock Name="NoResultsText"
                     Classes="hint"
                     AutomationProperties.AutomationId="KnowledgeNoResults"
                     Margin="6"
                     Text="No card matches those words."
                     IsVisible="{Binding HasNoResults}" />
          <ItemsControl Name="ResultList"
                        AutomationProperties.AutomationId="KnowledgeResults"
                        ItemsSource="{Binding Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KnowledgeLinkViewModel">
                <Button Classes="card-link"
                        AutomationProperties.AutomationId="KnowledgeResultButton"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{Binding Id}">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource CpTextPrimary}" Text="{Binding Title}" />
                    <TextBlock Classes="hint" Text="{Binding Summary}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

    </Panel>

    <GridSplitter Grid.Row="1"
                  Grid.Column="1"
                  AutomationProperties.AutomationId="KnowledgeSplitter"
                  AutomationProperties.Name="Resize the list of cards"
                  Theme="{DynamicResource SplitterGrip}"
                  Width="9"
                  ResizeDirection="Columns" />

    <!-- The card that is shown -->
    <ScrollViewer Grid.Row="1"
                  Grid.Column="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12,0,16,16" Spacing="6">

        <TextBlock Name="PlaceholderText"
                   Classes="hint"
                   AutomationProperties.AutomationId="KnowledgePlaceholder"
                   FontSize="{DynamicResource CpFontBody}"
                   Text="Choose a card in the tree, or search for some words."
                   IsVisible="{Binding !HasSelection}" />

        <StackPanel Spacing="6" IsVisible="{Binding HasSelection}">

          <SelectableTextBlock Name="CardTitleText"
                               AutomationProperties.AutomationId="KnowledgeCardTitle"
                               FontSize="{DynamicResource CpFontTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CpTextPrimary}"
                               TextWrapping="Wrap"
                               Text="{Binding CardTitle}" />
          <SelectableTextBlock Name="CardSummaryText"
                               AutomationProperties.AutomationId="KnowledgeCardSummary"
                               FontSize="{DynamicResource CpFontBodyLarge}"
                               Foreground="{DynamicResource CpTextSecondary}"
                               TextWrapping="Wrap"
                               Text="{Binding CardSummary}" />
          <TextBlock Name="CardTagsText"
                     Classes="hint"
                     AutomationProperties.AutomationId="KnowledgeCardTags"
                     Foreground="{DynamicResource CpTextTertiary}"
                     Text="{Binding TagsText}"
                     IsVisible="{Binding HasTags}" />
          <TextBlock Name="CardAliasesText"
                     Classes="hint"
                     AutomationProperties.AutomationId="KnowledgeCardAliases"
                     Foreground="{DynamicResource CpTextTertiary}"
                     Text="{Binding AliasesText}"
                     IsVisible="{Binding HasAliases}" />

          <!-- The text of the card, drawn from its Markdown -->
          <vm:MarkdownBlocksPanel Name="CardBody"
                                  AutomationProperties.AutomationId="KnowledgeCardBody"
                                  Blocks="{Binding Blocks}" />

          <StackPanel Spacing="2" IsVisible="{Binding HasChildren}">
            <TextBlock Classes="heading" Text="Cards below" />
            <ItemsControl Name="ChildList"
                          AutomationProperties.AutomationId="KnowledgeCardChildren"
                          ItemsSource="{Binding Children}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KnowledgeLinkViewModel">
                  <Button Classes="card-link"
                          AutomationProperties.AutomationId="KnowledgeChildButton"
                          Command="{Binding NavigateCommand}"
                          CommandParameter="{Binding Id}">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource CpTextPrimary}" Text="{Binding Title}" />
                      <TextBlock Classes="hint" Text="{Binding Summary}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="2" IsVisible="{Binding HasSeeAlso}">
            <TextBlock Classes="heading" Text="See also" />
            <ItemsControl Name="SeeAlsoList"
                          AutomationProperties.AutomationId="KnowledgeCardSeeAlso"
                          ItemsSource="{Binding SeeAlso}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KnowledgeLinkViewModel">
                  <Button Classes="card-link"
                          AutomationProperties.AutomationId="KnowledgeSeeAlsoButton"
                          Command="{Binding NavigateCommand}"
                          CommandParameter="{Binding Id}">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource CpTextPrimary}" Text="{Binding Title}" />
                      <TextBlock Classes="hint" Text="{Binding Summary}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding HasExamples}">
            <TextBlock Classes="heading" Text="Examples" />
            <ItemsControl Name="ExampleList"
                          AutomationProperties.AutomationId="KnowledgeCardExamples"
                          ItemsSource="{Binding Examples}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KnowledgeExampleViewModel">
                  <Border Classes="card" Margin="0,0,0,10" Padding="12">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   AutomationProperties.AutomationId="KnowledgeExampleHeader"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource CpTextPrimary}"
                                   TextWrapping="Wrap"
                                   Text="{Binding Header}" />
                        <Button Grid.Column="1"
                                AutomationProperties.AutomationId="KnowledgeCopyExampleButton"
                                Theme="{DynamicResource SecondaryButton}"
                                MinHeight="28"
                                Content="Copy"
                                Command="{Binding CopyCommand}"
                                CommandParameter="{Binding .}" />
                      </Grid>
                      <TextBlock Classes="hint" Text="{Binding Description}" />
                      <Border Background="{DynamicResource CpSurfacePane}"
                              BorderBrush="{DynamicResource CpBorderSubtle}"
                              BorderThickness="1"
                              CornerRadius="{DynamicResource CpRadiusInput}"
                              Padding="10">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="300">
                          <SelectableTextBlock AutomationProperties.AutomationId="KnowledgeExampleContent"
                                               FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                               Foreground="{DynamicResource CpTextPrimary}"
                                               TextWrapping="NoWrap"
                                               Text="{Binding Content}" />
                        </ScrollViewer>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- What the last copy did, and the Close button -->
    <Border Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Padding="16,12"
            Background="{DynamicResource CpSurfaceWindow}"
            BorderBrush="{DynamicResource CpBorderSubtle}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Name="StatusText"
                   Classes="hint"
                   Grid.Column="0"
                   AutomationProperties.AutomationId="KnowledgeStatus"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource CpFontBody}"
                   Text="{Binding Status}" />
        <Button Grid.Column="1"
                AutomationProperties.AutomationId="KnowledgeCloseButton"
                Theme="{DynamicResource SecondaryButton}"
                Content="Close"
                IsCancel="True"
                MinWidth="88"
                Command="{Binding CloseCommand}" />
      </Grid>
    </Border>

  </Grid>

</Window>
