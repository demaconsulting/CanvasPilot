<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemaConsulting.CanvasPilot.KnowledgeSubsystem"
        x:Class="DemaConsulting.CanvasPilot.KnowledgeSubsystem.KnowledgeBrowserView"
        x:DataType="vm:KnowledgeBrowserViewModel"
        Title="{Binding Title}"
        Icon="avares://DemaConsulting.CanvasPilot/Assets/Icon.png"
        Width="1000"
        Height="700"
        MinWidth="620"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <!-- A card in a list shows as a flat button, so that it reads as a link -->
    <Style Selector="Button.card-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
  </Window.Styles>

  <Grid Margin="12" RowDefinitions="Auto,*,Auto" ColumnDefinitions="300,Auto,*">

    <!-- Two or more letters search the cards and show the hits in place of the tree -->
    <TextBox Name="SearchBox"
             Grid.Row="0"
             Grid.Column="0"
             Grid.ColumnSpan="3"
             Margin="0,0,0,8"
             AutomationProperties.AutomationId="KnowledgeSearchBox"
             PlaceholderText="Search the cards (two or more letters)"
             Text="{Binding SearchText, Mode=TwoWay}" />

    <!-- The cards as a tree, or the hits of the search -->
    <Panel Grid.Row="1" Grid.Column="0">

      <TreeView Name="CardTree"
                AutomationProperties.AutomationId="KnowledgeCardTree"
                ItemsSource="{Binding Nodes}"
                SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                IsVisible="{Binding !IsSearching}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:KnowledgeNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="vm:KnowledgeNodeViewModel" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Title}" ToolTip.Tip="{Binding Summary}" />
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsSearching}">
        <StackPanel>
          <TextBlock Name="NoResultsText"
                     AutomationProperties.AutomationId="KnowledgeNoResults"
                     Margin="6"
                     Opacity="0.7"
                     TextWrapping="Wrap"
                     Text="No card matches those words."
                     IsVisible="{Binding HasNoResults}" />
          <ItemsControl Name="ResultList"
                        AutomationProperties.AutomationId="KnowledgeResults"
                        ItemsSource="{Binding Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KnowledgeLinkViewModel">
                <Button Classes="card-link"
                        AutomationProperties.AutomationId="KnowledgeResultButton"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{Binding Id}">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding Summary}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

    </Panel>

    <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" ResizeDirection="Columns" Background="Transparent" />

    <!-- The card that is shown -->
    <ScrollViewer Grid.Row="1"
                  Grid.Column="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,0" Spacing="6">

        <TextBlock Name="PlaceholderText"
                   AutomationProperties.AutomationId="KnowledgePlaceholder"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Text="Choose a card in the tree, or search for some words."
                   IsVisible="{Binding !HasSelection}" />

        <StackPanel Spacing="6" IsVisible="{Binding HasSelection}">

          <SelectableTextBlock Name="CardTitleText"
                               AutomationProperties.AutomationId="KnowledgeCardTitle"
                               FontSize="26"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding CardTitle}" />
          <SelectableTextBlock Name="CardSummaryText"
                               AutomationProperties.AutomationId="KnowledgeCardSummary"
                               Opacity="0.85"
                               TextWrapping="Wrap"
                               Text="{Binding CardSummary}" />
          <TextBlock Name="CardTagsText"
                     AutomationProperties.AutomationId="KnowledgeCardTags"
                     Opacity="0.7"
                     TextWrapping="Wrap"
                     Text="{Binding TagsText}"
                     IsVisible="{Binding HasTags}" />
          <TextBlock Name="CardAliasesText"
                     AutomationProperties.AutomationId="KnowledgeCardAliases"
                     Opacity="0.7"
                     TextWrapping="Wrap"
                     Text="{Binding AliasesText}"
                     IsVisible="{Binding HasAliases}" />

          <!-- The text of the card, drawn from its Markdown -->
          <vm:MarkdownBlocksPanel Name="CardBody"
                                  AutomationProperties.AutomationId="KnowledgeCardBody"
                                  Blocks="{Binding Blocks}" />

          <StackPanel Spacing="2" IsVisible="{Binding HasChildren}">
            <TextBlock Margin="0,10,0,0" FontSize="18" FontWeight="SemiBold" Text="Cards below" />
            <ItemsControl Name="ChildList"
                          AutomationProperties.AutomationId="KnowledgeCardChildren"
                          ItemsSource="{Binding Children}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KnowledgeLinkViewModel">
                  <Button Classes="card-link"
                          AutomationProperties.AutomationId="KnowledgeChildButton"
                          Command="{Binding NavigateCommand}"
                          CommandParameter="{Binding Id}">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                      <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding Summary}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="2" IsVisible="{Binding HasSeeAlso}">
            <TextBlock Margin="0,10,0,0" FontSize="18" FontWeight="SemiBold" Text="See also" />
            <ItemsControl Name="SeeAlsoList"
                          AutomationProperties.AutomationId="KnowledgeCardSeeAlso"
                          ItemsSource="{Binding SeeAlso}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KnowledgeLinkViewModel">
                  <Button Classes="card-link"
                          AutomationProperties.AutomationId="KnowledgeSeeAlsoButton"
                          Command="{Binding NavigateCommand}"
                          CommandParameter="{Binding Id}">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                      <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding Summary}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding HasExamples}">
            <TextBlock Margin="0,10,0,0" FontSize="18" FontWeight="SemiBold" Text="Examples" />
            <ItemsControl Name="ExampleList"
                          AutomationProperties.AutomationId="KnowledgeCardExamples"
                          ItemsSource="{Binding Examples}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KnowledgeExampleViewModel">
                  <Border Margin="0,0,0,10" Padding="8" BorderThickness="1" BorderBrush="#55808080" CornerRadius="4">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   AutomationProperties.AutomationId="KnowledgeExampleHeader"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding Header}" />
                        <Button Grid.Column="1"
                                AutomationProperties.AutomationId="KnowledgeCopyExampleButton"
                                Content="Copy"
                                Command="{Binding CopyCommand}"
                                CommandParameter="{Binding .}" />
                      </Grid>
                      <TextBlock Opacity="0.85" TextWrapping="Wrap" Text="{Binding Description}" />
                      <Border Background="#30808080" CornerRadius="4" Padding="8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="300">
                          <SelectableTextBlock AutomationProperties.AutomationId="KnowledgeExampleContent"
                                               FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                               TextWrapping="NoWrap"
                                               Text="{Binding Content}" />
                        </ScrollViewer>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- What the last copy did, and the Close button -->
    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
      <TextBlock Name="StatusText"
                 Grid.Column="0"
                 AutomationProperties.AutomationId="KnowledgeStatus"
                 VerticalAlignment="Center"
                 Opacity="0.85"
                 TextWrapping="Wrap"
                 Text="{Binding Status}" />
      <Button Grid.Column="1"
              AutomationProperties.AutomationId="KnowledgeCloseButton"
              Content="Close"
              IsCancel="True"
              MinWidth="80"
              Command="{Binding CloseCommand}" />
    </Grid>

  </Grid>

</Window>
