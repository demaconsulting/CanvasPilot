<!--
  Control themes of CanvasPilot: the shared looks that more than one view uses, built on the design tokens of
  Tokens.axaml (every color, radius, and space is a dynamic Cp resource, so a theme variant switch repaints them).

    IconButton    a 32 by 32 button that holds an icon (PathIcon of class icon); give it a tooltip and an
                  AutomationProperties.Name, because it has no text
    ToolToggle    the same, as a toggle; when checked it is filled with the accent and its icon is white
    PillButton    a rounded button with text, for suggestions and for the provider and style pills
    PrimaryButton the one main action of a window or card, filled with the accent (classes gradient and warning)
    SecondaryButton any other button of a window or card: raised with a quiet outline
    ChipBorder    the rounded outline of a chip of the transcript or the composer (a Border theme)
    SplitterGrip  a GridSplitter drawn as a 1 px line with a short grip, wider to hit; keyboard resize is 16 px

  Every one of them shows a 2 px focus ring (CpFocusRing, 1 px outside the control) when it is focused with the
  keyboard, and never after a click with the pointer, so the keyboard user always sees where they are and the pointer
  user is not distracted. The themes do not use BasedOn the Fluent themes: their templates are their own, so no
  state of the stock look shows through.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DemaConsulting.CanvasPilot.AppShellSubsystem">

  <Styles.Resources>
    <ResourceDictionary>

      <!-- IconButton -->
      <ControlTheme x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextSecondary}" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource CpRadiusInput}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border x:Name="PART_FocusRing"
                      Margin="-3"
                      BorderThickness="2"
                      BorderBrush="Transparent"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      IsHitTestVisible="False" />
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource CpAccentTintHover}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource CpAccentTint}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="BorderBrush" Value="{DynamicResource CpFocusRing}" />
        </Style>
      </ControlTheme>

      <!-- ToolToggle -->
      <ControlTheme x:Key="ToolToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextSecondary}" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource CpRadiusInput}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border x:Name="PART_FocusRing"
                      Margin="-3"
                      BorderThickness="2"
                      BorderBrush="Transparent"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      IsHitTestVisible="False" />
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource CpAccentTintHover}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource CpAccentTint}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{DynamicResource CpTextOnAccent}" />
        </Style>
        <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource CpAccent}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="BorderBrush" Value="{DynamicResource CpFocusRing}" />
        </Style>
      </ControlTheme>

      <!-- PillButton -->
      <ControlTheme x:Key="PillButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CpSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CpBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource CpFontSmall}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource CpRadiusPill}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border x:Name="PART_FocusRing"
                      Margin="-3"
                      BorderThickness="2"
                      BorderBrush="Transparent"
                      CornerRadius="{DynamicResource CpRadiusPill}"
                      IsHitTestVisible="False" />
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderBrush" Value="{DynamicResource CpAccent}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource CpAccentTint}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="BorderBrush" Value="{DynamicResource CpFocusRing}" />
        </Style>
      </ControlTheme>

      <!-- PrimaryButton: the one main action of a window or a card, filled with the accent (class gradient: the brand
           gradient; class warning: the amber of a notice, with the dark text that it needs). Needs a name when it only
           holds an icon. -->
      <ControlTheme x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CpAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextOnAccent}" />
        <Setter Property="FontSize" Value="{DynamicResource CpFontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource CpRadiusInput}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border x:Name="PART_FocusRing"
                      Margin="-3"
                      BorderThickness="2"
                      BorderBrush="Transparent"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      IsHitTestVisible="False" />
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^.gradient">
          <Setter Property="Background" Value="{DynamicResource CpAccentGradient}" />
        </Style>
        <Style Selector="^.warning">
          <Setter Property="Background" Value="{DynamicResource CpWarning}" />
          <Setter Property="Foreground" Value="{DynamicResource CpSurfaceWindow}" />
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="BorderBrush" Value="{DynamicResource CpFocusRing}" />
        </Style>
      </ControlTheme>

      <!-- SecondaryButton: any other button of a window or a card: raised, with a quiet outline; the outline turns to the accent
           under the pointer -->
      <ControlTheme x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CpSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CpBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource CpFontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource CpRadiusInput}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border x:Name="PART_FocusRing"
                      Margin="-3"
                      BorderThickness="2"
                      BorderBrush="Transparent"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      IsHitTestVisible="False" />
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderBrush" Value="{DynamicResource CpAccent}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource CpAccentTint}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="BorderBrush" Value="{DynamicResource CpFocusRing}" />
        </Style>
      </ControlTheme>

      <!-- CardButton: a whole card that is one button (a recent project of the welcome screen): raised, with a quiet outline
           that turns to the accent under the pointer and with the keyboard focus -->
      <ControlTheme x:Key="CardButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CpSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CpBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource CpRadiusWelcome}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border x:Name="PART_FocusRing"
                      Margin="-3"
                      BorderThickness="2"
                      BorderBrush="Transparent"
                      CornerRadius="{DynamicResource CpRadiusWelcome}"
                      IsHitTestVisible="False" />
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderBrush" Value="{DynamicResource CpAccent}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource CpAccentTint}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="BorderBrush" Value="{DynamicResource CpFocusRing}" />
        </Style>
      </ControlTheme>

      <!-- ChipBorder: the outline of a chip; the chip puts its icon and text inside -->
      <ControlTheme x:Key="ChipBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CpSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CpBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CpRadiusPill}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,0" />
      </ControlTheme>

      <!-- SplitterGrip: a vertical splitter between two columns. The control is as wide as its hit area (set by
           the view, 9 px in the workspace); the line is 1 px and the grip 4 by 40. -->
      <ControlTheme x:Key="SplitterGrip" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="KeyboardIncrement" Value="16" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent">
              <Border x:Name="PART_Line"
                      HorizontalAlignment="Center"
                      Width="1"
                      Background="{DynamicResource CpBorderSubtle}" />
              <Border x:Name="PART_Grip"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="4"
                      Height="40"
                      CornerRadius="2"
                      Background="{DynamicResource CpBorderControl}" />
              <Border x:Name="PART_FocusRing"
                      Margin="-1,0"
                      BorderThickness="2"
                      BorderBrush="Transparent"
                      IsHitTestVisible="False" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Line">
          <Setter Property="Width" Value="2" />
          <Setter Property="Background" Value="{DynamicResource CpAccent}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Line">
          <Setter Property="Width" Value="2" />
          <Setter Property="Background" Value="{DynamicResource CpAccent}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="BorderBrush" Value="{DynamicResource CpFocusRing}" />
        </Style>
      </ControlTheme>

      <!-- ExplorerTreeViewItem: a 26 px row of a tree with a chevron, indented by 16 px per level. Hover tints the row,
           the selected row has the accent tint and a 3 by 14 bar at its left edge (and the name is set semibold by the
           view), and keyboard focus draws the 2 px focus ring. The row is full width, and the content is the template of
           the view. -->
      <ControlTheme x:Key="ExplorerTreeViewItem" TargetType="TreeViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource CpFontBody}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="4,0,8,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource CpRadiusRow}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel>
              <Panel>
                <Border Name="PART_LayoutRoot"
                        MinHeight="{TemplateBinding MinHeight}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                  <Grid Name="PART_Header"
                        ColumnDefinitions="Auto,*"
                        Margin="{TemplateBinding Level, Converter={x:Static local:ThemeConverters.TreeLevelIndent}}">
                    <ToggleButton Name="PART_ExpandCollapseChevron"
                                  Grid.Column="0"
                                  Width="20"
                                  Height="20"
                                  Margin="4,0,0,0"
                                  Padding="0"
                                  VerticalAlignment="Center"
                                  Focusable="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{DynamicResource CpTextTertiary}"
                                  AutomationProperties.Name="Expand or collapse"
                                  IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
                      <ToggleButton.Template>
                        <ControlTemplate>
                          <Border Background="Transparent">
                            <PathIcon Name="PART_Chevron"
                                      Classes="icon"
                                      Width="12"
                                      Height="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{TemplateBinding Foreground}"
                                      Data="{DynamicResource CpIconChevronRight}">
                              <PathIcon.RenderTransform>
                                <RotateTransform Angle="0" />
                              </PathIcon.RenderTransform>
                            </PathIcon>
                          </Border>
                        </ControlTemplate>
                      </ToggleButton.Template>
                      <ToggleButton.Styles>
                        <Style Selector="ToggleButton:checked /template/ PathIcon#PART_Chevron">
                          <Setter Property="RenderTransform" Value="rotate(90deg)" />
                        </Style>
                      </ToggleButton.Styles>
                    </ToggleButton>
                    <ContentPresenter Name="PART_HeaderPresenter"
                                      Grid.Column="1"
                                      Focusable="False"
                                      Padding="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center" />
                  </Grid>
                </Border>
                <Border Name="PART_SelectionBar"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="3"
                        Height="14"
                        CornerRadius="2"
                        IsVisible="False"
                        IsHitTestVisible="False"
                        Background="{DynamicResource CpAccent}" />
                <Border Name="PART_FocusRing"
                        BorderThickness="2"
                        BorderBrush="Transparent"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsHitTestVisible="False" />
                <Rectangle Name="PART_DropRing"
                           RadiusX="6"
                           RadiusY="6"
                           Stroke="{DynamicResource CpAccent}"
                           StrokeThickness="1"
                           StrokeDashArray="3,2"
                           IsVisible="False"
                           IsHitTestVisible="False" />
              </Panel>
              <ItemsPresenter Name="PART_ItemsPresenter"
                              IsVisible="{TemplateBinding IsExpanded}"
                              ItemsPanel="{TemplateBinding ItemsPanel}" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
          <Setter Property="Background" Value="{DynamicResource CpAccentTintHover}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
          <Setter Property="Background" Value="{DynamicResource CpAccentTint}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_SelectionBar">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:selected">
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="^.droptarget /template/ Rectangle#PART_DropRing">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^.droptarget /template/ Border#PART_LayoutRoot">
          <Setter Property="Background" Value="{DynamicResource CpAccentTintHover}" />
        </Style>
        <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
          <Setter Property="IsHitTestVisible" Value="False" />
          <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="BorderBrush" Value="{DynamicResource CpFocusRing}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

</Styles>
