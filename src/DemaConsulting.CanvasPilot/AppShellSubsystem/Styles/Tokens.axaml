<!--
  Design tokens of CanvasPilot: the one source of every color, space, radius, type size, and shadow of the user
  interface. Views refer to these keys with {DynamicResource Cp...} and never write a literal value, so a theme
  variant switch repaints the whole window without a reload.

  Colors differ per theme variant and live in the Dark and Light theme dictionaries; space, radius, and type are
  the same in both variants. Every text color is at least 4.5:1 on the surfaces it is used on, and the colors of
  lines, icons, and the focus ring are at least 3:1. CpTextTertiary is for hints on the window, pane, stage, and
  raised surfaces only (not on overlays or on tinted rows), and is never used below 11 px.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

    <!-- Dark variant -->
    <ResourceDictionary x:Key="Dark">
      <!-- Surfaces -->
      <SolidColorBrush x:Key="CpSurfaceWindow" Color="#0d0f1f" />
      <SolidColorBrush x:Key="CpSurfacePane" Color="#131530" />
      <SolidColorBrush x:Key="CpSurfaceStage" Color="#0a0b18" />
      <SolidColorBrush x:Key="CpSurfaceRaised" Color="#1c1f42" />
      <SolidColorBrush x:Key="CpSurfaceOverlay" Color="#262a56" />

      <!-- Lines. CpBorderSubtle and CpBorderStrong separate and decorate; CpBorderControl is the outline that
           marks the edge of an input and is at least 3:1 on the pane and on raised surfaces. -->
      <SolidColorBrush x:Key="CpBorderSubtle" Color="#2a2d55" />
      <SolidColorBrush x:Key="CpBorderStrong" Color="#2f3366" />
      <SolidColorBrush x:Key="CpBorderControl" Color="#646c9f" />

      <!-- Text -->
      <SolidColorBrush x:Key="CpTextPrimary" Color="#eef0ff" />
      <SolidColorBrush x:Key="CpTextSecondary" Color="#b4b9de" />
      <SolidColorBrush x:Key="CpTextTertiary" Color="#8087b3" />

      <!-- Accent -->
      <SolidColorBrush x:Key="CpAccentText" Color="#a5b4fc" />
      <SolidColorBrush x:Key="CpAccentTint" Color="#424f46e5" />
      <SolidColorBrush x:Key="CpAccentTintHover" Color="#214f46e5" />
      <SolidColorBrush x:Key="CpFocusRing" Color="#818cf8" />

      <!-- State -->
      <SolidColorBrush x:Key="CpSuccess" Color="#34d399" />
      <SolidColorBrush x:Key="CpWarning" Color="#fbbf24" />
      <SolidColorBrush x:Key="CpWarningTint" Color="#26fbbf24" />
      <SolidColorBrush x:Key="CpDanger" Color="#f87171" />
      <SolidColorBrush x:Key="CpDangerTint" Color="#26f87171" />

      <!-- Elevation: floating bars (E3), menus and dialogs (E4), and the picture on the stage -->
      <BoxShadows x:Key="CpShadowFloating">0 4 16 0 #66000000</BoxShadows>
      <BoxShadows x:Key="CpShadowDialog">0 12 32 0 #80000000</BoxShadows>
      <BoxShadows x:Key="CpShadowPicture">0 14 32 0 #66000000</BoxShadows>
      <BoxShadows x:Key="CpShadowFocus">0 0 0 4 #2e818cf8</BoxShadows>

      <!-- The welcome screen: the dark look is the hero of the brand, a deep gradient with glows -->
      <LinearGradientBrush x:Key="CpWelcomeBackdrop" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#070b1f" Offset="0" />
        <GradientStop Color="#130f3b" Offset="0.5" />
        <GradientStop Color="#071a2e" Offset="1" />
      </LinearGradientBrush>
      <x:Double x:Key="CpWelcomeGlowOpacity">1</x:Double>
    </ResourceDictionary>

    <!-- Light variant -->
    <ResourceDictionary x:Key="Light">
      <!-- Surfaces -->
      <SolidColorBrush x:Key="CpSurfaceWindow" Color="#eceef8" />
      <SolidColorBrush x:Key="CpSurfacePane" Color="#f7f8fd" />
      <SolidColorBrush x:Key="CpSurfaceStage" Color="#e4e7f3" />
      <SolidColorBrush x:Key="CpSurfaceRaised" Color="#ffffff" />
      <SolidColorBrush x:Key="CpSurfaceOverlay" Color="#ffffff" />

      <!-- Lines -->
      <SolidColorBrush x:Key="CpBorderSubtle" Color="#dcdff0" />
      <SolidColorBrush x:Key="CpBorderStrong" Color="#cdd1e8" />
      <SolidColorBrush x:Key="CpBorderControl" Color="#7a80a8" />

      <!-- Text -->
      <SolidColorBrush x:Key="CpTextPrimary" Color="#14162e" />
      <SolidColorBrush x:Key="CpTextSecondary" Color="#454a74" />
      <SolidColorBrush x:Key="CpTextTertiary" Color="#646a92" />

      <!-- Accent -->
      <SolidColorBrush x:Key="CpAccentText" Color="#4338ca" />
      <SolidColorBrush x:Key="CpAccentTint" Color="#1f4f46e5" />
      <SolidColorBrush x:Key="CpAccentTintHover" Color="#0f4f46e5" />
      <SolidColorBrush x:Key="CpFocusRing" Color="#4f46e5" />

      <!-- State -->
      <SolidColorBrush x:Key="CpSuccess" Color="#047857" />
      <SolidColorBrush x:Key="CpWarning" Color="#a84e08" />
      <SolidColorBrush x:Key="CpWarningTint" Color="#1fa84e08" />
      <SolidColorBrush x:Key="CpDanger" Color="#b91c1c" />
      <SolidColorBrush x:Key="CpDangerTint" Color="#1fb91c1c" />

      <!-- Elevation -->
      <BoxShadows x:Key="CpShadowFloating">0 3 12 0 #331E1B4B</BoxShadows>
      <BoxShadows x:Key="CpShadowDialog">0 12 32 0 #401E1B4B</BoxShadows>
      <BoxShadows x:Key="CpShadowPicture">0 14 32 0 #331E1B4B</BoxShadows>
      <BoxShadows x:Key="CpShadowFocus">0 0 0 4 #2e4f46e5</BoxShadows>

      <!-- The light welcome screen is the pane color with the same glows at 12 percent -->
      <SolidColorBrush x:Key="CpWelcomeBackdrop" Color="#f7f8fd" />
      <x:Double x:Key="CpWelcomeGlowOpacity">0.12</x:Double>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- Colors that are the same in both variants: the brand accent and the gradient of the brand, white on the
       accent (6.3:1), and the color of marks drawn on a picture, with its 16 percent tint for mark chips -->
  <SolidColorBrush x:Key="CpAccent" Color="#4f46e5" />
  <SolidColorBrush x:Key="CpTextOnAccent" Color="#ffffff" />
  <SolidColorBrush x:Key="CpMark" Color="#ec4899" />
  <SolidColorBrush x:Key="CpMarkTint" Color="#29ec4899" />

  <!-- File-type badges of the explorer: a tile of one color per kind of file with a white glyph (at least 4.5:1), the same in
       both variants. A badge never carries the meaning alone, because the name and the extension are beside it. -->
  <SolidColorBrush x:Key="CpBadgeSvg" Color="#b45309" />
  <SolidColorBrush x:Key="CpBadgeMermaid" Color="#0f766e" />
  <SolidColorBrush x:Key="CpBadgeVega" Color="#be185d" />
  <SolidColorBrush x:Key="CpBadgePdf" Color="#b91c1c" />
  <SolidColorBrush x:Key="CpBadgeImage" Color="#1d4ed8" />
  <SolidColorBrush x:Key="CpBadgeData" Color="#6d28d9" />
  <SolidColorBrush x:Key="CpBadgeSource" Color="#475569" />
  <LinearGradientBrush x:Key="CpAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#4f46e5" Offset="0" />
    <GradientStop Color="#06b6d4" Offset="1" />
  </LinearGradientBrush>

  <!-- The gradient of the "Pilot" in the name of the application on the welcome screen -->
  <LinearGradientBrush x:Key="CpBrandTextGradient" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Color="#22d3ee" Offset="0" />
    <GradientStop Color="#a78bfa" Offset="0.55" />
    <GradientStop Color="#f472b6" Offset="1" />
  </LinearGradientBrush>

  <!-- The glows behind the welcome screen: violet, cyan, and pink, each fading to nothing at its edge -->
  <RadialGradientBrush x:Key="CpWelcomeGlowViolet" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
    <GradientStop Color="#997c3aed" Offset="0" />
    <GradientStop Color="#007c3aed" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="CpWelcomeGlowCyan" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
    <GradientStop Color="#6606b6d4" Offset="0" />
    <GradientStop Color="#0006b6d4" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="CpWelcomeGlowPink" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
    <GradientStop Color="#66ec4899" Offset="0" />
    <GradientStop Color="#00ec4899" Offset="1" />
  </RadialGradientBrush>

  <!-- Spacing scale -->
  <x:Double x:Key="CpSpace1">4</x:Double>
  <x:Double x:Key="CpSpace2">8</x:Double>
  <x:Double x:Key="CpSpace3">12</x:Double>
  <x:Double x:Key="CpSpace4">16</x:Double>
  <x:Double x:Key="CpSpace5">24</x:Double>
  <x:Double x:Key="CpSpace6">32</x:Double>
  <x:Double x:Key="CpSpace7">48</x:Double>

  <!-- Radii: key caps, rows and buttons, inputs, composer and bubbles and cards, welcome cards, pills and chips -->
  <CornerRadius x:Key="CpRadiusKey">4</CornerRadius>
  <CornerRadius x:Key="CpRadiusRow">6</CornerRadius>
  <CornerRadius x:Key="CpRadiusInput">8</CornerRadius>
  <CornerRadius x:Key="CpRadiusCard">14</CornerRadius>
  <CornerRadius x:Key="CpRadiusWelcome">16</CornerRadius>
  <CornerRadius x:Key="CpRadiusPill">999</CornerRadius>

  <!-- Type scale: sizes and the line heights that go with them -->
  <x:Double x:Key="CpFontCaption">11</x:Double>
  <x:Double x:Key="CpFontSmall">12</x:Double>
  <x:Double x:Key="CpFontBody">13</x:Double>
  <x:Double x:Key="CpFontBodyLarge">14</x:Double>
  <x:Double x:Key="CpFontSubtitle">16</x:Double>
  <x:Double x:Key="CpFontTitle">20</x:Double>
  <x:Double x:Key="CpFontDisplay">34</x:Double>
  <x:Double x:Key="CpLineCaption">16</x:Double>
  <x:Double x:Key="CpLineSmall">16</x:Double>
  <x:Double x:Key="CpLineBody">20</x:Double>
  <x:Double x:Key="CpLineBodyLarge">20</x:Double>
  <x:Double x:Key="CpLineSubtitle">24</x:Double>
  <x:Double x:Key="CpLineTitle">28</x:Double>
  <x:Double x:Key="CpLineDisplay">40</x:Double>

</ResourceDictionary>
