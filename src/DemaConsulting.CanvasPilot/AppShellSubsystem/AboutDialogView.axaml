<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemaConsulting.CanvasPilot.AppShellSubsystem"
        x:Class="DemaConsulting.CanvasPilot.AppShellSubsystem.AboutDialogView"
        x:DataType="vm:AboutDialogViewModel"
        Title="{Binding Title}"
        Icon="avares://DemaConsulting.CanvasPilot/Assets/Icon.png"
        Width="480"
        Height="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <TextBlock Grid.Row="0"
               AutomationProperties.AutomationId="AboutName"
               FontSize="24"
               FontWeight="SemiBold"
               Text="{Binding Name}" />

    <TextBlock Grid.Row="1"
               AutomationProperties.AutomationId="AboutTagline"
               Margin="0,4,0,0"
               TextWrapping="Wrap"
               Text="{Binding Tagline}" />

    <TextBlock Grid.Row="2"
               AutomationProperties.AutomationId="AboutVersion"
               Margin="0,12,0,0"
               Text="{Binding VersionText}" />

    <TextBlock Grid.Row="3"
               AutomationProperties.AutomationId="AboutCopyright"
               Margin="0,2,0,0"
               Opacity="0.8"
               Text="{Binding Copyright}" />

    <StackPanel Grid.Row="4" Margin="0,16,0,0" Spacing="4">
      <TextBlock FontWeight="SemiBold" Text="Built with open source software" />
      <ItemsControl AutomationProperties.AutomationId="AboutDependencies"
                    ItemsSource="{Binding Dependencies}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AboutDependency">
            <StackPanel Margin="0,4,0,0">
              <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
              <TextBlock Opacity="0.8" TextWrapping="Wrap" Text="{Binding Description}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Button Grid.Row="5"
            AutomationProperties.AutomationId="AboutCloseButton"
            HorizontalAlignment="Right"
            Content="Close"
            IsDefault="True"
            IsCancel="True"
            MinWidth="80"
            Command="{Binding CloseCommand}" />

  </Grid>

</Window>
