<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemaConsulting.CanvasPilot.AppShellSubsystem"
        x:Class="DemaConsulting.CanvasPilot.AppShellSubsystem.AboutDialogView"
        x:DataType="vm:AboutDialogViewModel"
        Title="{Binding Title}"
        Icon="avares://DemaConsulting.CanvasPilot/Assets/Icon.png"
        Width="520"
        Height="520"
        CanResize="False"
        Background="{DynamicResource CpSurfacePane}"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto">

    <Grid Grid.Row="0" Margin="24,24,24,16" RowDefinitions="Auto,Auto,*">

      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16">
        <Border Width="56"
                Height="56"
                CornerRadius="16"
                VerticalAlignment="Center"
                Background="{DynamicResource CpAccentGradient}">
          <PathIcon Classes="icon"
                    Width="32"
                    Height="32"
                    Foreground="{DynamicResource CpTextOnAccent}"
                    Data="{DynamicResource CpIconSparkle}" />
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock AutomationProperties.AutomationId="AboutName"
                     Classes="pageTitle"
                     FontSize="24"
                     Text="{Binding Name}" />
          <TextBlock AutomationProperties.AutomationId="AboutTagline"
                     Classes="hint"
                     FontSize="{DynamicResource CpFontBody}"
                     Text="{Binding Tagline}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="2">
        <TextBlock AutomationProperties.AutomationId="AboutVersion"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource CpTextPrimary}"
                   Text="{Binding VersionText}" />
        <TextBlock AutomationProperties.AutomationId="AboutCopyright"
                   Classes="hint"
                   Text="{Binding Copyright}" />
      </StackPanel>

      <Border Grid.Row="2" Classes="card" Margin="0,16,0,0" Padding="16,12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Classes="sectionTitle" Margin="0,0,0,4" Text="Built with open source software" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl AutomationProperties.AutomationId="AboutDependencies"
                          ItemsSource="{Binding Dependencies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AboutDependency">
                  <StackPanel Margin="0,6,0,0">
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource CpTextPrimary}" Text="{Binding Name}" />
                    <TextBlock Classes="hint" Text="{Binding Description}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

    </Grid>

    <Border Grid.Row="1"
            Padding="24,12"
            Background="{DynamicResource CpSurfaceWindow}"
            BorderBrush="{DynamicResource CpBorderSubtle}"
            BorderThickness="0,1,0,0">
      <Button AutomationProperties.AutomationId="AboutCloseButton"
              Theme="{DynamicResource PrimaryButton}"
              HorizontalAlignment="Right"
              Content="Close"
              IsDefault="True"
              IsCancel="True"
              MinWidth="88"
              Command="{Binding CloseCommand}" />
    </Border>

  </Grid>

</Window>
