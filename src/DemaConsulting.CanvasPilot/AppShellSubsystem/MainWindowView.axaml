<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemaConsulting.CanvasPilot.AppShellSubsystem"
        x:Class="DemaConsulting.CanvasPilot.AppShellSubsystem.MainWindowView"
        x:DataType="vm:MainWindowShell"
        Name="MainWindow"
        Title="{Binding Title}"
        Icon="avares://DemaConsulting.CanvasPilot/Assets/Icon.png"
        Width="1440"
        Height="900"
        MinWidth="960"
        MinHeight="600"
        Background="{DynamicResource CpSurfaceWindow}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">

  <Window.Resources>
    <!-- Each recent project becomes a menu item that shows its name and opens the project. -->
    <ControlTheme x:Key="RecentProjectMenuItemTheme"
                  TargetType="MenuItem"
                  x:DataType="vm:RecentProjectItem"
                  BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Header" Value="{Binding Header}" />
      <Setter Property="Command" Value="{Binding OpenCommand}" />
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <!-- The window draws its own title text at the left of the strip when the frame is extended (Avalonia 12 on Windows
         and Linux), which would lie under the brand mark and the menu; the strip has its own centered title. -->
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The menu keeps all its items and keys; only its look is quiet: no fill, compact items, secondary text. -->
    <Style Selector="Menu#MainMenu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Menu#MainMenu > MenuItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Foreground" Value="{DynamicResource CpTextSecondary}" />
      <Setter Property="FontSize" Value="{DynamicResource CpFontBody}" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- The title bar: 44 px high. When the platform lets the window extend into its frame, the strip is the frame
         and the system keeps drawing the window buttons over its right end (reserved below); when it cannot, the same
         strip is a normal row under the system title bar. The empty strip drags the window. -->
    <Border DockPanel.Dock="Top"
            Name="AppTitleBar"
            AutomationProperties.AutomationId="AppTitleBar"
            Height="44"
            Background="{DynamicResource CpSurfaceWindow}"
            BorderBrush="{DynamicResource CpBorderSubtle}"
            BorderThickness="0,0,0,1"
            WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">

        <Border Name="TitleBarLeadingReserve" Grid.Column="0" Width="0" />

        <Border Grid.Column="1"
                Width="24"
                Height="24"
                Margin="16,0,12,0"
                VerticalAlignment="Center"
                CornerRadius="7"
                IsHitTestVisible="False"
                Background="{DynamicResource CpAccentGradient}">
          <PathIcon Classes="icon"
                    Width="14"
                    Height="14"
                    Foreground="{DynamicResource CpTextOnAccent}"
                    Data="{DynamicResource CpIconSparkle}" />
        </Border>

        <Menu Grid.Column="2"
              Name="MainMenu"
              AutomationProperties.AutomationId="MainMenu"
              WindowDecorationProperties.ElementRole="User">

      <MenuItem Name="FileMenu"
                AutomationProperties.AutomationId="FileMenu"
                Header="_File">
        <MenuItem Name="NewProjectMenuItem"
                  AutomationProperties.AutomationId="NewProjectMenuItem"
                  Header="_New Project..."
                  HotKey="{OnPlatform 'Ctrl+N', macOS='Cmd+N'}"
                  InputGesture="{OnPlatform 'Ctrl+N', macOS='Cmd+N'}"
                  Command="{Binding NewProjectCommand}" />
        <MenuItem Name="OpenProjectMenuItem"
                  AutomationProperties.AutomationId="OpenProjectMenuItem"
                  Header="_Open Project..."
                  HotKey="{OnPlatform 'Ctrl+O', macOS='Cmd+O'}"
                  InputGesture="{OnPlatform 'Ctrl+O', macOS='Cmd+O'}"
                  Command="{Binding OpenProjectCommand}" />
        <MenuItem Name="RecentProjectsMenuItem"
                  AutomationProperties.AutomationId="RecentProjectsMenuItem"
                  Header="_Recent Projects"
                  IsEnabled="{Binding HasRecentProjects}"
                  ItemContainerTheme="{StaticResource RecentProjectMenuItemTheme}"
                  ItemsSource="{Binding RecentProjects}" />
        <Separator />
        <MenuItem Name="SaveProjectMenuItem"
                  AutomationProperties.AutomationId="SaveProjectMenuItem"
                  Header="_Save Project"
                  HotKey="{OnPlatform 'Ctrl+S', macOS='Cmd+S'}"
                  InputGesture="{OnPlatform 'Ctrl+S', macOS='Cmd+S'}"
                  Command="{Binding SaveProjectCommand}" />
        <MenuItem Name="CloseProjectMenuItem"
                  AutomationProperties.AutomationId="CloseProjectMenuItem"
                  Header="_Close Project"
                  Command="{Binding CloseProjectCommand}" />
        <Separator />
        <MenuItem Name="ExitMenuItem"
                  AutomationProperties.AutomationId="ExitMenuItem"
                  Header="E_xit"
                  Command="{Binding ExitCommand}" />
      </MenuItem>

      <MenuItem Name="EditMenu"
                AutomationProperties.AutomationId="EditMenu"
                Header="_Edit">
        <MenuItem Name="UndoMenuItem"
                  AutomationProperties.AutomationId="UndoMenuItem"
                  Header="_Undo"
                  InputGesture="{OnPlatform 'Ctrl+Z', macOS='Cmd+Z'}"
                  Command="{Binding UndoCommand}" />
        <MenuItem Name="RedoMenuItem"
                  AutomationProperties.AutomationId="RedoMenuItem"
                  Header="_Redo"
                  InputGesture="{OnPlatform 'Ctrl+Y', macOS='Cmd+Shift+Z'}"
                  Command="{Binding RedoCommand}" />
      </MenuItem>

      <MenuItem Name="ImageMenu"
                AutomationProperties.AutomationId="ImageMenu"
                Header="_Image">
        <MenuItem Name="ExportPngMenuItem"
                  AutomationProperties.AutomationId="ExportPngMenuItem"
                  Header="_Export as PNG..."
                  Command="{Binding ExportPngCommand}" />
        <MenuItem Name="CopyImageMenuItem"
                  AutomationProperties.AutomationId="CopyImageMenuItem"
                  Header="_Copy Image"
                  Command="{Binding CopyImageCommand}" />
        <Separator />
        <MenuItem Name="CheckAgainstStyleMenuItem"
                  AutomationProperties.AutomationId="CheckAgainstStyleMenuItem"
                  Header="Check _Against Style"
                  Command="{Binding CheckAgainstStyleCommand}" />
      </MenuItem>

      <MenuItem Name="ToolsMenu"
                AutomationProperties.AutomationId="ToolsMenu"
                Header="_Tools">
        <MenuItem Name="StyleKitsMenuItem"
                  AutomationProperties.AutomationId="StyleKitsMenuItem"
                  Header="Style _Kits..."
                  Command="{Binding ShowStyleKitsCommand}" />
        <MenuItem Name="SettingsMenuItem"
                  AutomationProperties.AutomationId="SettingsMenuItem"
                  Header="_Settings..."
                  Command="{Binding OpenSettingsCommand}" />
      </MenuItem>

      <MenuItem Name="HelpMenu"
                AutomationProperties.AutomationId="HelpMenu"
                Header="_Help">
        <MenuItem Name="DrawingKnowledgeMenuItem"
                  AutomationProperties.AutomationId="DrawingKnowledgeMenuItem"
                  Header="_Drawing Knowledge..."
                  Command="{Binding ShowDrawingKnowledgeCommand}" />
        <MenuItem Name="OpenLogFolderMenuItem"
                  AutomationProperties.AutomationId="OpenLogFolderMenuItem"
                  Header="Open _Log Folder"
                  Command="{Binding OpenLogFolderCommand}" />
        <Separator />
        <MenuItem Name="AboutMenuItem"
                  AutomationProperties.AutomationId="AboutMenuItem"
                  Header="_About CanvasPilot"
                  Command="{Binding ShowAboutCommand}" />
      </MenuItem>

    </Menu>

        <!-- The name of the open project (or of the application) in the middle, with the application after it -->
        <TextBlock Grid.Column="3"
                   Name="TitleBarText"
                   AutomationProperties.AutomationId="AppTitleBarText"
                   Margin="16,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   IsHitTestVisible="False"
                   FontSize="{DynamicResource CpFontBody}"
                   Foreground="{DynamicResource CpTextTertiary}">
          <TextBlock.Inlines>
            <Run Name="TitleBarName"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource CpTextPrimary}"
                 Text="{Binding TitleBarName}" /><Run Name="TitleBarSuffix" Text="{Binding TitleBarSuffix}" />
          </TextBlock.Inlines>
        </TextBlock>

        <!-- The style kit of the open project is chosen here; it shows while a project is open. -->
        <ContentControl Name="StylePickerHost"
                        Grid.Column="4"
                        AutomationProperties.AutomationId="StylePickerHost"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        WindowDecorationProperties.ElementRole="User"
                        Content="{Binding StylePicker}" />

        <!-- The AI provider: which one is chosen and whether it can be used; it opens the settings -->
        <ContentControl Name="ProviderPillHost"
                        Grid.Column="5"
                        AutomationProperties.AutomationId="ProviderPillHost"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Content="{Binding ProviderPill}" />

        <Border Name="TitleBarCaptionReserve" Grid.Column="6" Width="0" />

      </Grid>
    </Border>

    <!-- The status bar is always there: it says what the picture is, and whether the project is saved. -->
    <vm:StatusBarView DockPanel.Dock="Bottom"
                      DataContext="{Binding StatusBar}" />

    <!-- With no project open the welcome screen fills the body; the workspace takes its place once a project is open. -->
    <Grid>
      <ContentControl Name="WorkspaceHost"
                      AutomationProperties.AutomationId="WorkspaceHost"
                      IsVisible="{Binding HasProject}"
                      Content="{Binding Workspace}" />
      <ContentControl Name="WelcomeHost"
                      AutomationProperties.AutomationId="WelcomeHost"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      IsVisible="{Binding !HasProject}"
                      Content="{Binding Welcome}" />
    </Grid>

  </DockPanel>

</Window>
