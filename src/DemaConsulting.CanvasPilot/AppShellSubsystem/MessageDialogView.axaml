<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemaConsulting.CanvasPilot.AppShellSubsystem"
        x:Class="DemaConsulting.CanvasPilot.AppShellSubsystem.MessageDialogView"
        x:DataType="vm:MessageDialogViewModel"
        Title="{Binding Title}"
        Icon="avares://DemaConsulting.CanvasPilot/Assets/Icon.png"
        Width="480"
        Height="240"
        CanResize="False"
        Background="{DynamicResource CpSurfacePane}"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto">

    <StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="12">
      <TextBlock AutomationProperties.AutomationId="MessageDialogText"
                 FontSize="{DynamicResource CpFontBodyLarge}"
                 Foreground="{DynamicResource CpTextPrimary}"
                 Text="{Binding Message}"
                 TextWrapping="Wrap" />

      <TextBox AutomationProperties.AutomationId="MessageDialogInput"
               AutomationProperties.Name="Answer"
               IsVisible="{Binding IsPrompt}"
               Text="{Binding InputText}" />
    </StackPanel>

    <Border Grid.Row="1"
            Padding="24,12"
            Background="{DynamicResource CpSurfaceWindow}"
            BorderBrush="{DynamicResource CpBorderSubtle}"
            BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button AutomationProperties.AutomationId="MessageDialogOkButton"
                Theme="{DynamicResource PrimaryButton}"
                Content="{Binding OkText}"
                IsDefault="True"
                MinWidth="88"
                Command="{Binding OkCommand}" />
        <Button AutomationProperties.AutomationId="MessageDialogCancelButton"
                Theme="{DynamicResource SecondaryButton}"
                Content="Cancel"
                IsCancel="True"
                IsVisible="{Binding ShowCancel}"
                MinWidth="88"
                Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>

  </Grid>

</Window>
