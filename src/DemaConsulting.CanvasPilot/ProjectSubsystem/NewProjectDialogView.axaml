<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemaConsulting.CanvasPilot.ProjectSubsystem"
        x:Class="DemaConsulting.CanvasPilot.ProjectSubsystem.NewProjectDialogView"
        x:DataType="vm:NewProjectDialogViewModel"
        Title="{Binding Title}"
        Icon="avares://DemaConsulting.CanvasPilot/Assets/Icon.ico"
        Width="560"
        Height="360"
        CanResize="False"
        Background="{DynamicResource CpSurfacePane}"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto">

    <StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="6">

      <TextBlock Classes="label" Text="Project name" />
      <TextBox AutomationProperties.AutomationId="NewProjectNameTextBox"
               AutomationProperties.Name="Project name"
               Text="{Binding ProjectName}" />
      <TextBlock Classes="error"
                 AutomationProperties.AutomationId="NewProjectNameError"
                 IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{Binding NameError}" />

      <TextBlock Classes="label" Text="Location" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBox Grid.Column="0"
                 AutomationProperties.AutomationId="NewProjectFolderTextBox"
                 AutomationProperties.Name="Location"
                 Text="{Binding ParentFolder}" />
        <Button Grid.Column="2"
                AutomationProperties.AutomationId="NewProjectBrowseButton"
                Theme="{DynamicResource SecondaryButton}"
                Content="Browse..."
                Command="{Binding BrowseCommand}" />
      </Grid>
      <TextBlock Classes="error"
                 AutomationProperties.AutomationId="NewProjectFolderError"
                 IsVisible="{Binding FolderError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{Binding FolderError}" />
      <TextBlock Classes="error"
                 AutomationProperties.AutomationId="NewProjectTargetError"
                 IsVisible="{Binding TargetError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{Binding TargetError}" />

      <TextBlock Classes="hint"
                 AutomationProperties.AutomationId="NewProjectTargetPath"
                 Margin="0,8,0,0"
                 IsVisible="{Binding TargetPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{Binding TargetPath, StringFormat='The project folder will be created at: {0}'}" />

    </StackPanel>

    <Border Grid.Row="1"
            Padding="24,12"
            Background="{DynamicResource CpSurfaceWindow}"
            BorderBrush="{DynamicResource CpBorderSubtle}"
            BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button AutomationProperties.AutomationId="NewProjectOkButton"
                Theme="{DynamicResource PrimaryButton}"
                Content="OK"
                IsDefault="True"
                MinWidth="88"
                Command="{Binding OkCommand}" />
        <Button AutomationProperties.AutomationId="NewProjectCancelButton"
                Theme="{DynamicResource SecondaryButton}"
                Content="Cancel"
                IsCancel="True"
                MinWidth="88"
                Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>

  </Grid>

</Window>
