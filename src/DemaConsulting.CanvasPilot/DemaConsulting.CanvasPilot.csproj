<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>DemaConsulting.CanvasPilot</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DemaConsulting.Speech" Version="0.2.0-beta.2" />
    <PackageReference Include="DemaConsulting.Speech.Sherpa" Version="0.2.0-beta.2" />
    <PackageReference Include="DemaConsulting.CanvasNet.Viewer" Version="0.2.0-beta.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- DEMA Consulting logo, sourced from the repository-root Icon.png, exposed for the
         window icon via avares://DemaConsulting.CanvasPilot/Assets/Icon.png. -->
    <AvaloniaResource Include="..\..\Icon.png" Link="Assets\Icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal members (e.g. PathHelpers) to the test projects that exercise them
         directly, so tests can reuse the same reviewed helpers as production code. -->
    <InternalsVisibleTo Include="DemaConsulting.CanvasPilot.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.CanvasPilot.UiTests" />
    <InternalsVisibleTo Include="OtsSoftwareTests" />
  </ItemGroup>

</Project>
