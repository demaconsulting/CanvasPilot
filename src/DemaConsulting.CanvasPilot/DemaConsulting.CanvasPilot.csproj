<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>DemaConsulting.CanvasPilot</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DemaConsulting.Speech" Version="0.2.0-beta.2" />
    <PackageReference Include="DemaConsulting.Speech.Sherpa" Version="0.2.0-beta.2" />
    <PackageReference Include="DemaConsulting.CanvasNet.Viewer" Version="0.2.0-beta.13" />
    <!-- The AI agent library. Core gives the confined tool framework, Agents.Copilot the GitHub Copilot agent factory
         and the runtime that runs the Copilot CLI that the user installed (its own bundled runtime is never shipped, see
         CopilotSkipCliDownload in Directory.Build.props), Agents.ChatClient the agent factory for any chat client, and
         Agents.Ollama the Ollama context sizing. DemaConsulting.AgentKit.Tools is deliberately not referenced: this
         version of it pins DemaConsulting.CanvasNet 0.2.0-beta.13, the same version that this project uses, so it could
         be added later without a conflict, but its tool packs are not used yet. -->
    <PackageReference Include="DemaConsulting.AgentKit.Core" Version="0.1.0-beta.4" />
    <PackageReference Include="DemaConsulting.AgentKit.Agents.Copilot" Version="0.1.0-beta.4" />
    <PackageReference Include="DemaConsulting.AgentKit.Agents.ChatClient" Version="0.1.0-beta.4" />
    <PackageReference Include="DemaConsulting.AgentKit.Agents.Ollama" Version="0.1.0-beta.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- DEMA Consulting logo, sourced from the repository-root Icon.png, exposed for the
         window icon via avares://DemaConsulting.CanvasPilot/Assets/Icon.png. -->
    <AvaloniaResource Include="..\..\Icon.png" Link="Assets\Icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The knowledge cards and examples of CanvasPilot, in the layout that CanvasNet's help catalog reads from an
         assembly: a card is named by its path under Cards, an example by its file name under Examples.
         WithCulture="false" keeps MSBuild from reading a dotted name as a satellite-resource culture. -->
    <EmbeddedResource Include="KnowledgeSubsystem\Cards\**\*.md" WithCulture="false"
                      LogicalName="DemaConsulting.CanvasPilot.Knowledge/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="KnowledgeSubsystem\Examples\*" WithCulture="false"
                      LogicalName="DemaConsulting.CanvasPilot.Knowledge.Examples.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The role prompt of the AI copilot, the fixed part of its instructions. -->
    <EmbeddedResource Include="AgentSubsystem\Instructions\RolePrompt.md" WithCulture="false"
                      LogicalName="DemaConsulting.CanvasPilot.Agent.RolePrompt.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- The style kits that come with the program, as loose files so that an assistant can be given real paths of the
         example pictures. They are copied beside the executable in the folder StyleKits (build output and publish
         output), which a single-file publish leaves as loose files. -->
    <Content Include="StyleSubsystem\BuiltIn\**\*" Link="StyleKits\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal members (e.g. PathHelpers) to the test projects that exercise them
         directly, so tests can reuse the same reviewed helpers as production code. -->
    <InternalsVisibleTo Include="DemaConsulting.CanvasPilot.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.CanvasPilot.UiTests" />
    <InternalsVisibleTo Include="OtsSoftwareTests" />
  </ItemGroup>

</Project>
