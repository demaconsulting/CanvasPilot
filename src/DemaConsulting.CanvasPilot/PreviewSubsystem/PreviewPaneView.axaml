<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DemaConsulting.CanvasPilot.PreviewSubsystem"
             x:Class="DemaConsulting.CanvasPilot.PreviewSubsystem.PreviewPaneView"
             x:DataType="vm:PreviewPaneViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomToFitCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding ZoomActualSizeCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- The Fit toggle of the zoom pill shows its state as an accent tint with an accent outline and accent icon, which
         also holds while the pointer is over it right after the click, so it is never unclear whether Fit is on -->
    <Style Selector="ToggleButton.zoomfit:checked">
      <Setter Property="Foreground" Value="{DynamicResource CpAccentText}" />
    </Style>
    <Style Selector="ToggleButton.zoomfit:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CpAccentTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CpAccentText}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid>

    <!-- The stage: the picture sits on a quiet surface with a dot grid, with the tools floating over it -->
    <Grid Name="Stage"
          AutomationProperties.AutomationId="PreviewStage"
          ClipToBounds="True"
          Background="{DynamicResource CpSurfaceStage}">

      <Border Name="StageDots"
              IsHitTestVisible="False"
              Opacity="0.2">
        <Border.Background>
          <DrawingBrush TileMode="Tile" DestinationRect="0,0,20,20" Stretch="None">
            <DrawingBrush.Drawing>
              <GeometryDrawing Brush="{DynamicResource CpTextTertiary}">
                <GeometryDrawing.Geometry>
                  <EllipseGeometry Center="10,10" RadiusX="1" RadiusY="1" />
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Border.Background>
      </Border>

      <ScrollViewer Name="ImageScroller"
                    AutomationProperties.AutomationId="PreviewScroller"
                    Focusable="True"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled"
                    IsVisible="{Binding HasImage}">
        <!-- The Viewbox scales the whole surface, so everything on it, picture and overlay alike, is laid out in
             picture pixels whatever the zoom is. The margin leaves room for the shadow and keeps the picture clear of
             the floating tools. -->
        <Viewbox Name="PreviewViewbox"
                 AutomationProperties.AutomationId="PreviewViewbox"
                 Margin="32,64"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Stretch="Uniform"
                 StretchDirection="DownOnly">
          <Grid Name="PreviewSurface"
                AutomationProperties.AutomationId="PreviewSurface"
                Background="Transparent">
            <Border BoxShadow="{DynamicResource CpShadowPicture}" IsHitTestVisible="False" />
            <Image Name="PreviewImage"
                   AutomationProperties.AutomationId="PreviewImage"
                   Stretch="None" />
            <ContentControl Name="PreviewOverlay"
                            AutomationProperties.AutomationId="PreviewOverlay"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsVisible="{Binding HasOverlay}"
                            Content="{Binding Overlay}" />
          </Grid>
        </Viewbox>
      </ScrollViewer>

      <!-- The render error: a card in the middle of the stage -->
      <Border Name="ErrorCard"
              Margin="24"
              Padding="20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MaxWidth="560"
              CornerRadius="{DynamicResource CpRadiusCard}"
              Background="{DynamicResource CpSurfaceRaised}"
              BorderBrush="{DynamicResource CpDanger}"
              BorderThickness="1"
              BoxShadow="{DynamicResource CpShadowFloating}"
              IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="Auto,*">
          <PathIcon Grid.Column="0"
                    Classes="icon"
                    Width="24"
                    Height="24"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource CpDanger}"
                    Data="{DynamicResource CpIconErrorCircle}" />
          <StackPanel Grid.Column="1"
                      Name="ErrorPanel"
                      AutomationProperties.AutomationId="PreviewErrorPanel"
                      Spacing="6"
                      IsVisible="{Binding HasError}">
            <TextBlock AutomationProperties.AutomationId="PreviewErrorTitle"
                       FontSize="{DynamicResource CpFontSubtitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CpDanger}"
                       TextWrapping="Wrap"
                       Text="{Binding ErrorTitle}" />
            <TextBlock AutomationProperties.AutomationId="PreviewErrorMessage"
                       Foreground="{DynamicResource CpTextPrimary}"
                       TextWrapping="Wrap"
                       Text="{Binding ErrorMessage}" />
            <TextBlock AutomationProperties.AutomationId="PreviewErrorHint"
                       Foreground="{DynamicResource CpTextSecondary}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasErrorHint}"
                       Text="{Binding ErrorHint}" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock AutomationProperties.AutomationId="PreviewPlaceholder"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="{DynamicResource CpFontSubtitle}"
                 Foreground="{DynamicResource CpTextSecondary}"
                 IsVisible="{Binding ShowPlaceholder}"
                 Text="{Binding PlaceholderText}" />

      <!-- Busy: a thin line of the accent gradient along the top of the stage -->
      <ProgressBar Name="BusyIndicator"
                   AutomationProperties.AutomationId="PreviewBusy"
                   AutomationProperties.Name="Rendering"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Height="2"
                   MinHeight="0"
                   Background="Transparent"
                   Foreground="{DynamicResource CpAccentGradient}"
                   IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}" />

      <!-- The slot for the host's controls floats over the stage and is outside the scaled picture, so they keep
           their size at every zoom. -->
      <ContentControl Name="PreviewToolbar"
                      AutomationProperties.AutomationId="PreviewToolbar"
                      Margin="12"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsVisible="{Binding HasToolbar}"
                      Content="{Binding Toolbar}" />

      <!-- The zoom pill: Fit, actual size, smaller, the zoom in effect, and larger -->
      <Border Name="ZoomPill"
              AutomationProperties.AutomationId="PreviewZoomPill"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="16"
              Padding="4"
              Height="36"
              CornerRadius="{DynamicResource CpRadiusPill}"
              Background="{DynamicResource CpSurfaceOverlay}"
              BorderBrush="{DynamicResource CpBorderSubtle}"
              BorderThickness="1"
              BoxShadow="{DynamicResource CpShadowFloating}"
              IsVisible="{Binding HasImage}">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <ToggleButton Name="FitToWindowButton"
                        Classes="zoomfit"
                        Theme="{DynamicResource ToolToggle}"
                        AutomationProperties.AutomationId="PreviewFitToWindow"
                        AutomationProperties.Name="Fit to window"
                        ToolTip.Tip="Fit to window  Ctrl+0"
                        IsChecked="{Binding FitToWindow}">
            <PathIcon Classes="icon" Data="{DynamicResource CpIconFullScreenMaximize}" />
          </ToggleButton>
          <Button Name="ZoomActualButton"
                  Theme="{DynamicResource IconButton}"
                  MinWidth="32"
                  AutomationProperties.AutomationId="PreviewZoomActual"
                  AutomationProperties.Name="Actual size"
                  ToolTip.Tip="Actual size  Ctrl+1"
                  Command="{Binding ZoomActualSizeCommand}">
            <TextBlock FontSize="{DynamicResource CpFontSmall}" Text="1:1" />
          </Button>
          <Button Name="ZoomOutButton"
                  Theme="{DynamicResource IconButton}"
                  AutomationProperties.AutomationId="PreviewZoomOut"
                  AutomationProperties.Name="Zoom out"
                  ToolTip.Tip="Zoom out  Ctrl+Minus"
                  IsEnabled="{Binding IsZoomOutPossible}"
                  Command="{Binding ZoomOutCommand}">
            <PathIcon Classes="icon" Data="{DynamicResource CpIconSubtract}" />
          </Button>
          <Button Name="ZoomLabelButton"
                  Theme="{DynamicResource IconButton}"
                  MinWidth="48"
                  AutomationProperties.AutomationId="PreviewZoomLabel"
                  AutomationProperties.Name="Zoom, click to fit to window"
                  ToolTip.Tip="Click to fit to window"
                  Command="{Binding ZoomToFitCommand}">
            <TextBlock FontSize="{DynamicResource CpFontSmall}"
                       Foreground="{DynamicResource CpTextPrimary}"
                       Text="{Binding ZoomLabel}" />
          </Button>
          <Button Name="ZoomInButton"
                  Theme="{DynamicResource IconButton}"
                  AutomationProperties.AutomationId="PreviewZoomIn"
                  AutomationProperties.Name="Zoom in"
                  ToolTip.Tip="Zoom in  Ctrl+Plus"
                  IsEnabled="{Binding IsZoomInPossible}"
                  Command="{Binding ZoomInCommand}">
            <PathIcon Classes="icon" Data="{DynamicResource CpIconAdd}" />
          </Button>
        </StackPanel>
      </Border>

      <!-- Notes of the render: a drawer over the bottom left of the stage, closed to a warning chip, and raised above the
           zoom pill (16 px margin, 36 px high, 8 px gap) so that the two never overlap on a narrow stage. The status line of
           the picture is in the status bar of the main window, which follows this pane. -->
      <Expander Name="DiagnosticsDrawer"
                AutomationProperties.AutomationId="PreviewDiagnosticsExpander"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="16,16,16,60"
                MaxWidth="480"
                Padding="0"
                ExpandDirection="Up"
                CornerRadius="{DynamicResource CpRadiusInput}"
                Background="{DynamicResource CpSurfaceOverlay}"
                BorderBrush="{DynamicResource CpBorderSubtle}"
                BorderThickness="1"
                Header="{Binding DiagnosticsHeader}"
                IsExpanded="{Binding AreDiagnosticsExpanded, Mode=TwoWay}"
                IsVisible="{Binding HasDiagnostics}">
        <Expander.HeaderTemplate>
          <DataTemplate x:DataType="x:String">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Classes="icon" Foreground="{DynamicResource CpWarning}" Data="{DynamicResource CpIconWarning}" />
              <TextBlock FontSize="{DynamicResource CpFontSmall}"
                         Foreground="{DynamicResource CpTextPrimary}"
                         VerticalAlignment="Center"
                         Text="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </Expander.HeaderTemplate>
        <ScrollViewer MaxHeight="160">
          <ItemsControl Margin="8,4"
                        AutomationProperties.AutomationId="PreviewDiagnostics"
                        ItemsSource="{Binding Diagnostics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RenderDiagnostic">
                <TextBlock Margin="0,1"
                           FontSize="{DynamicResource CpFontSmall}"
                           Foreground="{DynamicResource CpTextSecondary}"
                           TextWrapping="Wrap"
                           Text="{Binding DisplayText}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Expander>

    </Grid>

  </Grid>

</UserControl>
