<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemaConsulting.CanvasPilot.PreviewSubsystem"
        x:Class="DemaConsulting.CanvasPilot.PreviewSubsystem.ExportPresetDialogView"
        x:DataType="vm:ExportPresetDialogViewModel"
        Title="{Binding Title}"
        Icon="avares://DemaConsulting.CanvasPilot/Assets/Icon.ico"
        Width="520"
        Height="440"
        MinWidth="420"
        MinHeight="340"
        Background="{DynamicResource CpSurfacePane}"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto">

    <Grid Grid.Row="0" Margin="24,24,24,16" RowDefinitions="Auto,*,Auto">

      <TextBlock Grid.Row="0"
                 Classes="sectionTitle"
                 Text="Choose how the picture is exported."
                 Margin="0,0,0,12" />

      <ListBox Grid.Row="1"
               AutomationProperties.AutomationId="ExportPresetList"
               AutomationProperties.Name="Export sizes"
               ItemsSource="{Binding Items}"
               SelectedItem="{Binding SelectedItem}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ExportPresetItemViewModel">
            <StackPanel Margin="4,2" Spacing="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Classes="hint" Text="{Binding SizeLine}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="2"
                 Classes="hint"
                 AutomationProperties.AutomationId="ExportPresetResult"
                 FontSize="{DynamicResource CpFontBody}"
                 Margin="0,12,0,0"
                 Text="{Binding ResultText}" />

    </Grid>

    <Border Grid.Row="1"
            Padding="24,12"
            Background="{DynamicResource CpSurfaceWindow}"
            BorderBrush="{DynamicResource CpBorderSubtle}"
            BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button AutomationProperties.AutomationId="ExportPresetOkButton"
                Theme="{DynamicResource PrimaryButton}"
                Content="Export..."
                IsDefault="True"
                MinWidth="88"
                Command="{Binding ExportCommand}" />
        <Button AutomationProperties.AutomationId="ExportPresetCancelButton"
                Theme="{DynamicResource SecondaryButton}"
                Content="Cancel"
                IsCancel="True"
                MinWidth="88"
                Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>

  </Grid>

</Window>
