<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemaConsulting.CanvasPilot.PreviewSubsystem"
        x:Class="DemaConsulting.CanvasPilot.PreviewSubsystem.ExportPresetDialogView"
        x:DataType="vm:ExportPresetDialogViewModel"
        Title="{Binding Title}"
        Icon="avares://DemaConsulting.CanvasPilot/Assets/Icon.png"
        Width="520"
        Height="420"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto">

    <TextBlock Grid.Row="0"
               Text="Choose how the picture is exported."
               Margin="0,0,0,8" />

    <ListBox Grid.Row="1"
             AutomationProperties.AutomationId="ExportPresetList"
             ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedItem}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ExportPresetItemViewModel">
          <StackPanel Margin="4,2" Spacing="2">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SizeLine}" Opacity="0.7" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="2"
               AutomationProperties.AutomationId="ExportPresetResult"
               Margin="0,8,0,0"
               TextWrapping="Wrap"
               Text="{Binding ResultText}" />

    <StackPanel Grid.Row="3"
                Margin="0,16,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button AutomationProperties.AutomationId="ExportPresetOkButton"
              Content="Export..."
              IsDefault="True"
              MinWidth="80"
              Command="{Binding ExportCommand}" />
      <Button AutomationProperties.AutomationId="ExportPresetCancelButton"
              Content="Cancel"
              IsCancel="True"
              MinWidth="80"
              Command="{Binding CancelCommand}" />
    </StackPanel>

  </Grid>

</Window>
