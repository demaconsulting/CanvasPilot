<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DemaConsulting.CanvasPilot.ChatSubsystem"
             xmlns:composer="using:DemaConsulting.CanvasPilot.ComposerSubsystem"
             x:Class="DemaConsulting.CanvasPilot.ChatSubsystem.ChatPanelView"
             x:DataType="vm:ChatPanelViewModel"
             AutomationProperties.AutomationId="ChatPanel">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

    <!-- The header of the conversation: the sparkle, the title, the menu of more actions, and the button that hides the
         column. The menu holds the item that deletes the saved chat history of the project, empties the transcript, and
         makes the copilot forget the conversation; it does not ask first. -->
    <Border Grid.Row="0"
            Height="48"
            Padding="16,0,8,0"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource CpBorderSubtle}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Column="0"
                Width="22"
                Height="22"
                CornerRadius="11"
                VerticalAlignment="Center"
                Background="{DynamicResource CpAccentGradient}">
          <PathIcon Classes="icon"
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource CpTextOnAccent}"
                    Data="{DynamicResource CpIconSparkle}" />
        </Border>
        <TextBlock Grid.Column="1"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource CpFontBodyLarge}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource CpTextPrimary}"
                   Text="Conversation" />
        <Button Name="OverflowButton"
                Grid.Column="2"
                AutomationProperties.AutomationId="ChatOverflowButton"
                AutomationProperties.Name="More conversation actions"
                Theme="{DynamicResource IconButton}"
                ToolTip.Tip="More conversation actions">
          <PathIcon Classes="icon" Data="{DynamicResource CpIconMoreHorizontal}" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Name="ClearHistoryItem"
                        AutomationProperties.AutomationId="ChatClearHistoryButton"
                        Header="Clear chat history"
                        Command="{Binding ClearHistoryCommand}"
                        ToolTip.Tip="Delete the saved chat history of this project from this computer and start the conversation again" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Name="CollapseButton"
                Grid.Column="3"
                AutomationProperties.AutomationId="ChatCollapseButton"
                AutomationProperties.Name="Hide the conversation"
                Theme="{DynamicResource IconButton}"
                Command="{Binding CollapseCommand}"
                ToolTip.Tip="Hide the conversation">
          <PathIcon Classes="icon" Data="{DynamicResource CpIconPanelRight}" />
        </Button>
      </Grid>
    </Border>

    <!-- Whether the copilot can be used, with what to do when it cannot; hidden when everything is ready -->
    <Border Name="ReadinessBanner"
            Grid.Row="1"
            AutomationProperties.AutomationId="ChatReadinessBanner"
            Margin="16,12,16,0"
            Padding="12,10"
            CornerRadius="{DynamicResource CpRadiusInput}"
            Background="{DynamicResource CpWarningTint}"
            IsVisible="{Binding HasReadinessIssue}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <PathIcon Classes="icon"
                  VerticalAlignment="Top"
                  Margin="0,2,0,0"
                  Foreground="{DynamicResource CpWarning}"
                  Data="{DynamicResource CpIconWarning}" />
        <StackPanel Grid.Column="1" Spacing="8">
          <SelectableTextBlock Name="ReadinessText"
                               AutomationProperties.AutomationId="ChatReadinessMessage"
                               FontSize="{DynamicResource CpFontSmall}"
                               Foreground="{DynamicResource CpTextPrimary}"
                               TextWrapping="Wrap"
                               Text="{Binding ReadinessMessage}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="ReadinessOpenSettingsButton"
                    AutomationProperties.AutomationId="ChatReadinessOpenSettingsButton"
                    Theme="{DynamicResource PillButton}"
                    MinHeight="26"
                    Content="Open Settings"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip.Tip="Open the settings of the application" />
            <Button Name="ReadinessCheckAgainButton"
                    AutomationProperties.AutomationId="ChatReadinessCheckAgainButton"
                    Theme="{DynamicResource PillButton}"
                    MinHeight="26"
                    Content="Check again"
                    Command="{Binding CheckAgainCommand}"
                    ToolTip.Tip="Check again whether the copilot can be used" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The conversation, oldest first: the messages that were sent, the answers of the copilot, the tools it called, and
         notices; what was said is saved on this computer, outside the project, and it cannot be changed. While it is empty
         the pane says what to try. -->
    <Grid Grid.Row="2">
      <ScrollViewer Name="TranscriptScroll"
                    AutomationProperties.AutomationId="ChatTranscriptScroll"
                    Padding="16,12"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl Name="TranscriptList"
                      AutomationProperties.AutomationId="ChatTranscript"
                      ItemsSource="{Binding Transcript}" />
      </ScrollViewer>

      <StackPanel Name="EmptyState"
                  Margin="24,0"
                  MaxWidth="320"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8"
                  IsVisible="{Binding !HasTranscript}">
        <Border Width="56"
                Height="56"
                Margin="0,0,0,8"
                CornerRadius="28"
                HorizontalAlignment="Center"
                Background="{DynamicResource CpAccentGradient}">
          <PathIcon Classes="icon"
                    Width="28"
                    Height="28"
                    Foreground="{DynamicResource CpTextOnAccent}"
                    Data="{DynamicResource CpIconSparkle}" />
        </Border>
        <TextBlock Name="EmptyTranscriptText"
                   AutomationProperties.AutomationId="ChatTranscriptEmpty"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource CpFontSubtitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource CpTextPrimary}"
                   Text="{x:Static vm:ChatPanelViewModel.EmptyTranscriptText}" />
        <ItemsControl Name="ExamplePromptList"
                      Margin="0,8,0,0"
                      ItemsSource="{x:Static vm:ChatPanelViewModel.ExamplePrompts}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Button AutomationProperties.AutomationId="ChatExamplePrompt"
                      Theme="{DynamicResource PillButton}"
                      HorizontalAlignment="Stretch"
                      MinHeight="36"
                      Content="{Binding}"
                      Click="OnPromptClicked" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Name="EmptyTipText"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource CpFontSmall}"
                   Foreground="{DynamicResource CpTextTertiary}"
                   Text="{x:Static vm:ChatPanelViewModel.EmptyTipText}" />
      </StackPanel>
    </Grid>

    <!-- While the copilot works: the indicator and the button that stops it -->
    <Grid Name="BusyRow"
          Grid.Row="3"
          AutomationProperties.AutomationId="ChatBusyIndicator"
          Margin="16,8,16,0"
          ColumnDefinitions="Auto,*,Auto"
          IsVisible="{Binding IsCopilotBusy}">
      <ProgressBar Grid.Column="0"
                   Width="60"
                   Height="4"
                   Margin="0,0,8,0"
                   IsIndeterminate="True"
                   VerticalAlignment="Center" />
      <TextBlock Name="BusyText"
                 Grid.Column="1"
                 AutomationProperties.AutomationId="ChatBusyText"
                 VerticalAlignment="Center"
                 Text="{x:Static vm:ChatPanelViewModel.WorkingText}" />
      <Button Name="StopButton"
              Grid.Column="2"
              AutomationProperties.AutomationId="ChatStopButton"
              MinWidth="80"
              Content="Stop"
              Command="{Binding StopCommand}"
              ToolTip.Tip="Stop the copilot; what it has written so far is kept" />
    </Grid>

    <!-- A few follow-ups to try, while a conversation is going on and the copilot is idle -->
    <ItemsControl Name="SuggestionList"
                  Grid.Row="4"
                  Margin="16,8,16,0"
                  ItemsSource="{x:Static vm:ChatPanelViewModel.SuggestedPrompts}"
                  IsVisible="{Binding ShowSuggestions}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="8" LineSpacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Button AutomationProperties.AutomationId="ChatSuggestion"
                  Theme="{DynamicResource PillButton}"
                  Content="{Binding}"
                  Click="OnPromptClicked" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- The message being written, with the words that are being recognized and the status line of the composer -->
    <Border Grid.Row="5"
            Margin="16,8,16,0"
            Padding="4"
            BorderThickness="1"
            CornerRadius="4"
            BorderBrush="{DynamicResource CpBorderSubtle}">
      <composer:ComposerEditorView Name="ComposerView"
                                   MaxHeight="240"
                                   DataContext="{Binding Composer}" />
    </Border>

    <!-- Hold to talk, and Send -->
    <Grid Grid.Row="6" Margin="16,8,16,16" ColumnDefinitions="*,Auto,Auto">
      <Button Name="HoldToTalkButton"
              Grid.Column="1"
              AutomationProperties.AutomationId="ChatHoldToTalkButton"
              Margin="0,0,8,0"
              MinWidth="150"
              Content="{Binding TalkText}"
              IsEnabled="{Binding CanTalk}"
              ToolTip.Tip="Hold this button, speak, and let go to add what you said to the message" />
      <Button Name="SendButton"
              Grid.Column="2"
              AutomationProperties.AutomationId="ChatSendButton"
              MinWidth="80"
              Content="Send"
              Command="{Binding SendCommand}"
              ToolTip.Tip="Send the message" />
    </Grid>

  </Grid>

</UserControl>
