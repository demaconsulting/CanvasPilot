<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemaConsulting.CanvasPilot.ChatSubsystem"
        x:Class="DemaConsulting.CanvasPilot.ChatSubsystem.PayloadInspectorView"
        x:DataType="vm:PayloadInspectorViewModel"
        Title="{Binding Title}"
        Icon="avares://DemaConsulting.CanvasPilot/Assets/Icon.ico"
        Width="980"
        Height="700"
        MinWidth="560"
        MinHeight="360"
        Background="{DynamicResource CpSurfacePane}"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto,*">

    <!-- What the assistant would receive, as text: the message with the places of the marks and attachments, the
         attachments, and for each marked picture its marks with geometry, note, area, and source elements -->
    <Grid Grid.Row="0" Grid.Column="0" Margin="16,16,0,16" RowDefinitions="Auto,*">
      <TextBlock Grid.Row="0"
                 Classes="sectionTitle"
                 Margin="0,0,0,8"
                 Text="What the assistant would receive" />
      <TextBox Name="DescriptionText"
               Grid.Row="1"
               AutomationProperties.AutomationId="PayloadInspectorText"
               AutomationProperties.Name="What the assistant would receive"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               Text="{Binding Description, Mode=OneWay}" />
    </Grid>

    <GridSplitter Grid.Row="0"
                  Grid.Column="1"
                  AutomationProperties.AutomationId="PayloadInspectorSplitter"
                  AutomationProperties.Name="Resize the text and the pictures"
                  Theme="{DynamicResource SplitterGrip}"
                  Width="9"
                  ResizeDirection="Columns" />

    <!-- The pictures of the payload: each marked picture with its marks drawn on it, and the area around each mark -->
    <Grid Grid.Row="0" Grid.Column="2" Margin="0,16,16,16" RowDefinitions="Auto,*">
      <TextBlock Grid.Row="0"
                 Classes="sectionTitle"
                 Margin="0,0,0,8"
                 Text="Pictures" />
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Name="NoPicturesText"
                     Classes="hint"
                     AutomationProperties.AutomationId="PayloadInspectorNoPictures"
                     FontSize="{DynamicResource CpFontBody}"
                     Text="This message has no marks, so it has no pictures."
                     IsVisible="{Binding !HasPictures}" />
          <ItemsControl Name="PictureList"
                        AutomationProperties.AutomationId="PayloadInspectorPictures"
                        ItemsSource="{Binding Pictures}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PayloadPictureViewModel">
                <StackPanel Margin="0,0,0,12" Spacing="4">
                  <TextBlock AutomationProperties.AutomationId="PayloadInspectorPictureCaption"
                             Classes="hint"
                             Text="{Binding Caption}" />
                  <Border BorderThickness="1" BorderBrush="{DynamicResource CpBorderStrong}" HorizontalAlignment="Left">
                    <Image AutomationProperties.AutomationId="PayloadInspectorPicture"
                           Stretch="Uniform"
                           StretchDirection="DownOnly"
                           MaxWidth="440"
                           MaxHeight="320"
                           Source="{Binding Bitmap}" />
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Padding="16,12"
            Background="{DynamicResource CpSurfaceWindow}"
            BorderBrush="{DynamicResource CpBorderSubtle}"
            BorderThickness="0,1,0,0">
      <Button AutomationProperties.AutomationId="PayloadInspectorCloseButton"
              Theme="{DynamicResource PrimaryButton}"
              HorizontalAlignment="Right"
              Content="Close"
              IsDefault="True"
              IsCancel="True"
              MinWidth="88"
              Command="{Binding CloseCommand}" />
    </Border>

  </Grid>

</Window>
