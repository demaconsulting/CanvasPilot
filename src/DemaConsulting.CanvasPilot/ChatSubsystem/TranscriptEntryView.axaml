<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DemaConsulting.CanvasPilot.ChatSubsystem"
             x:Class="DemaConsulting.CanvasPilot.ChatSubsystem.TranscriptEntryView"
             x:DataType="vm:TranscriptEntryViewModel"
             AutomationProperties.AutomationId="TranscriptEntry">

  <UserControl.Styles>
    <!-- The text button that shows the payload is there for the keyboard and for the pointer that is over the message, and
         out of the way otherwise -->
    <Style Selector="Button#ViewPayloadButton">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource CpAccentText}" />
      <Setter Property="FontSize" Value="{DynamicResource CpFontCaption}" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="Grid.entry:pointerover Button#ViewPayloadButton, Grid.entry:focus-within Button#ViewPayloadButton">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- One message that was sent: a bubble at the right with its words and the chips of its attachments and marks in their
       places, when it was sent below it with the button that shows exactly what the assistant would receive, and a
       statement of what it carried. The bubble is at most 85 percent of the width. -->
  <Grid Classes="entry"
        Margin="0,0,0,16"
        ColumnDefinitions="0.15*,0.85*"
        RowDefinitions="Auto,Auto,Auto">

    <Border Grid.Column="1"
            HorizontalAlignment="Right"
            Padding="12,8"
            CornerRadius="14,14,4,14"
            Background="{DynamicResource CpAccent}">
      <SelectableTextBlock Name="MessageText"
                           AutomationProperties.AutomationId="TranscriptMessageText"
                           Foreground="{DynamicResource CpTextOnAccent}"
                           FontSize="{DynamicResource CpFontBody}"
                           LineHeight="{DynamicResource CpLineBody}"
                           TextWrapping="Wrap" />
    </Border>

    <StackPanel Grid.Row="1"
                Grid.Column="1"
                Margin="0,2,2,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
      <Button Name="ViewPayloadButton"
              AutomationProperties.AutomationId="TranscriptViewPayloadButton"
              VerticalAlignment="Center"
              Content="View payload"
              Command="{Binding ViewPayloadCommand}"
              ToolTip.Tip="See exactly what the assistant would receive for this message" />
      <TextBlock Name="SentTimeText"
                 AutomationProperties.AutomationId="TranscriptSentTime"
                 VerticalAlignment="Center"
                 FontSize="{DynamicResource CpFontCaption}"
                 Foreground="{DynamicResource CpTextTertiary}"
                 Text="{Binding SentText}" />
    </StackPanel>

    <TextBlock Name="SummaryText"
               Grid.Row="2"
               Grid.Column="1"
               Margin="0,2,2,0"
               HorizontalAlignment="Right"
               TextAlignment="Right"
               TextWrapping="Wrap"
               AutomationProperties.AutomationId="TranscriptSummary"
               FontSize="{DynamicResource CpFontSmall}"
               Foreground="{DynamicResource CpTextSecondary}"
               Text="{Binding Summary}"
               IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

  </Grid>

</UserControl>
