<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DemaConsulting.CanvasPilot.ComposerSubsystem.ChipView"
             AutomationProperties.AutomationId="ComposerChip"
             Focusable="False">

  <UserControl.Styles>
    <!-- A mark chip is pink, like the mark on the picture -->
    <Style Selector="Border#ChipBorder.mark">
      <Setter Property="Background" Value="{DynamicResource CpMarkTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CpMark}" />
    </Style>
    <Style Selector="Border#ChipBorder.mark Path#IconPath">
      <Setter Property="Fill" Value="{DynamicResource CpMark}" />
    </Style>
  </UserControl.Styles>

  <!-- The chip as it stands in a line of the message: a pill with an icon or picture, the name, and a button that deletes
       it. The colors are tokens, so the chip reads on a light and a dark theme alike. -->
  <Border Name="ChipBorder"
          Theme="{DynamicResource ChipBorder}"
          Margin="1,0"
          Padding="6,0,2,0">
    <StackPanel Orientation="Horizontal" Spacing="4">
      <Panel Width="16" Height="16" VerticalAlignment="Center">
        <Path Name="IconPath"
              Fill="{DynamicResource CpTextSecondary}"
              Stretch="Uniform" />
        <Border CornerRadius="4" ClipToBounds="True">
          <Image Name="ThumbnailImage"
                 AutomationProperties.AutomationId="ComposerChipThumbnail"
                 Stretch="UniformToFill"
                 IsVisible="False" />
        </Border>
      </Panel>
      <TextBlock Name="LabelText"
                 AutomationProperties.AutomationId="ComposerChipLabel"
                 VerticalAlignment="Center"
                 FontSize="{DynamicResource CpFontSmall}"
                 Foreground="{DynamicResource CpTextPrimary}"
                 MaxWidth="180"
                 TextTrimming="CharacterEllipsis" />
      <Button Name="DeleteButton"
              AutomationProperties.AutomationId="ComposerChipDelete"
              Theme="{DynamicResource IconButton}"
              VerticalAlignment="Center"
              Width="18"
              Height="18"
              MinWidth="0"
              MinHeight="0"
              CornerRadius="9"
              Focusable="False">
        <PathIcon Classes="icon"
                  Width="10"
                  Height="10"
                  Data="{DynamicResource CpIconDismiss}" />
      </Button>
    </StackPanel>
  </Border>

</UserControl>
