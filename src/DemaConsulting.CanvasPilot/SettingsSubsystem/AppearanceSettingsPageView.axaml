<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DemaConsulting.CanvasPilot.SettingsSubsystem"
             x:Class="DemaConsulting.CanvasPilot.SettingsSubsystem.AppearanceSettingsPageView"
             x:DataType="vm:AppearanceSettingsPageViewModel"
             AutomationProperties.AutomationId="SettingsAppearancePage">

  <ScrollViewer>
    <StackPanel Spacing="6" Margin="0,0,12,0">

      <TextBlock Text="Theme" />
      <ComboBox AutomationProperties.AutomationId="AppearanceThemeComboBox"
                AutomationProperties.Name="Theme"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding Themes}"
                SelectedItem="{Binding SelectedTheme}" />
      <TextBlock Text="Follow system uses the dark or the light theme of the operating system and changes with it."
                 Foreground="{DynamicResource CpTextSecondary}"
                 FontSize="{DynamicResource CpFontSmall}"
                 TextWrapping="Wrap" />

      <TextBlock Text="Project explorer" Margin="0,16,0,0" />
      <CheckBox AutomationProperties.AutomationId="AppearanceShowThumbnailsCheckBox"
                Content="Show a small picture beside each file"
                IsChecked="{Binding ShowThumbnails}" />
      <CheckBox AutomationProperties.AutomationId="AppearanceComfortableRowsCheckBox"
                Content="Comfortable rows (taller, with more room between files)"
                IsChecked="{Binding ComfortableRows}" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
