<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DemaConsulting.CanvasPilot.SettingsSubsystem"
             x:Class="DemaConsulting.CanvasPilot.SettingsSubsystem.AiProviderSettingsPageView"
             x:DataType="vm:AiProviderSettingsPageViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.failed">
      <Setter Property="Foreground" Value="{DynamicResource CpDanger}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Spacing="16" Margin="0,0,12,24">

      <!-- Which provider and model the copilot uses -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="sectionTitle" Text="Provider and model" Margin="0,0,0,6" />

          <TextBlock Classes="label" Text="Provider" />
          <ComboBox AutomationProperties.AutomationId="AiProviderComboBox"
                    AutomationProperties.Name="Provider"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Providers}"
                    SelectedItem="{Binding SelectedProvider}" />

          <TextBlock Classes="label" Text="Model" Margin="0,8,0,0" />
          <ComboBox x:Name="ModelList"
                    AutomationProperties.AutomationId="AiModelComboBox"
                    AutomationProperties.Name="Model"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding HasModelList}"
                    ItemsSource="{Binding Models}"
                    SelectedItem="{Binding SelectedModel}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModelChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.Styles>
              <Style Selector="ComboBoxItem" x:DataType="vm:ModelChoice">
                <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
              </Style>
            </ComboBox.Styles>
          </ComboBox>
          <TextBlock Classes="hint"
                     Text="Model name (type one that is not listed)"
                     IsVisible="{Binding HasModelList}" />
          <TextBox AutomationProperties.AutomationId="AiModelNameTextBox"
                   AutomationProperties.Name="Model name"
                   PlaceholderText="Leave empty to use the provider's default model"
                   Text="{Binding ModelName}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button AutomationProperties.AutomationId="AiRefreshModelsButton"
                    Theme="{DynamicResource SecondaryButton}"
                    Content="Refresh models"
                    IsVisible="{Binding HasModelSource}"
                    IsEnabled="{Binding !IsLoadingModels}"
                    Command="{Binding RefreshModelsCommand}" />
            <TextBlock Classes="hint"
                       AutomationProperties.AutomationId="AiModelListMessage"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasModelListMessage}"
                       Text="{Binding ModelListMessage}" />
          </StackPanel>
          <TextBlock Classes="hint"
                     AutomationProperties.AutomationId="AiModelDetails"
                     IsVisible="{Binding ModelDetails, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding ModelDetails}" />
          <TextBlock Classes="caution"
                     AutomationProperties.AutomationId="AiModelWarning"
                     IsVisible="{Binding ModelWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding ModelWarning}" />

          <TextBlock Classes="label" Text="Reasoning level" Margin="0,8,0,0" />
          <ComboBox AutomationProperties.AutomationId="AiReasoningEffortComboBox"
                    AutomationProperties.Name="Reasoning level"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding IsReasoningEffortEnabled}"
                    ItemsSource="{Binding ReasoningEfforts}"
                    SelectedItem="{Binding SelectedReasoningEffort}" />
          <TextBlock Classes="hint"
                     AutomationProperties.AutomationId="AiReasoningEffortNote"
                     IsVisible="{Binding HasReasoningNote}"
                     Text="{Binding ReasoningNote}" />
          <TextBlock Classes="caution"
                     AutomationProperties.AutomationId="AiEffortCostWarning"
                     IsVisible="{Binding HasEffortCostWarning}"
                     Text="{Binding EffortCostWarning}" />
        </StackPanel>
      </Border>

      <!-- Where the provider is: each entry is shown only while the provider that it belongs to is selected -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="sectionTitle" Text="Connection" Margin="0,0,0,6" />

          <!-- Ollama only -->
          <TextBlock Classes="label"
                     AutomationProperties.AutomationId="AiContextWindowLabel"
                     Text="Context window (tokens)"
                     IsVisible="{Binding IsOllamaSelected}" />
          <TextBox AutomationProperties.AutomationId="AiContextWindowTextBox"
                   AutomationProperties.Name="Context window in tokens"
                   IsVisible="{Binding IsOllamaSelected}"
                   Text="{Binding ContextWindowText}" />
          <TextBlock Classes="error"
                     AutomationProperties.AutomationId="AiContextWindowError"
                     IsVisible="{Binding ContextWindowError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding ContextWindowError}" />
          <TextBlock Classes="caution"
                     AutomationProperties.AutomationId="AiContextWindowWarning"
                     IsVisible="{Binding ContextWindowWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding ContextWindowWarning}" />

          <TextBlock Classes="label"
                     AutomationProperties.AutomationId="AiOllamaEndpointLabel"
                     Text="Ollama endpoint"
                     Margin="0,8,0,0"
                     IsVisible="{Binding IsOllamaSelected}" />
          <TextBox AutomationProperties.AutomationId="AiOllamaEndpointTextBox"
                   AutomationProperties.Name="Ollama endpoint"
                   IsVisible="{Binding IsOllamaSelected}"
                   Text="{Binding OllamaEndpoint}" />
          <TextBlock Classes="error"
                     AutomationProperties.AutomationId="AiOllamaEndpointError"
                     IsVisible="{Binding OllamaEndpointError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding OllamaEndpointError}" />

          <!-- GitHub Copilot only -->
          <TextBlock Classes="label"
                     AutomationProperties.AutomationId="AiCopilotCliPathLabel"
                     Text="GitHub Copilot command-line tool path"
                     IsVisible="{Binding IsCopilotSelected}" />
          <TextBox AutomationProperties.AutomationId="AiCopilotCliPathTextBox"
                   AutomationProperties.Name="GitHub Copilot command-line tool path"
                   IsVisible="{Binding IsCopilotSelected}"
                   PlaceholderText="Leave empty to locate the tool automatically"
                   Text="{Binding CopilotCliPath}" />
          <TextBlock Classes="error"
                     AutomationProperties.AutomationId="AiCopilotCliPathError"
                     IsVisible="{Binding CopilotCliPathError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding CopilotCliPathError}" />
          <TextBlock Classes="hint"
                     AutomationProperties.AutomationId="AiCopilotCliPathNote"
                     IsVisible="{Binding IsCopilotSelected}"
                     Text="{x:Static vm:AiProviderSettingsPageViewModel.CopilotCliPathNoteText}" />
        </StackPanel>
      </Border>

      <!-- Whether the provider can be used -->
      <Border Classes="card"
              IsVisible="{Binding HasConnectionCheck}">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Check" />
          <Button AutomationProperties.AutomationId="AiCheckConnectionButton"
                  HorizontalAlignment="Left"
                  Theme="{DynamicResource SecondaryButton}"
                  Content="Check connection"
                  IsVisible="{Binding HasConnectionCheck}"
                  Command="{Binding CheckConnectionCommand}" />
          <TextBlock AutomationProperties.AutomationId="AiCheckConnectionResult"
                     Classes.failed="{Binding IsCheckConnectionFailed}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasCheckConnectionResult}"
                     Text="{Binding CheckConnectionResult}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
