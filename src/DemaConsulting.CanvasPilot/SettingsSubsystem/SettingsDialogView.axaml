<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemaConsulting.CanvasPilot.SettingsSubsystem"
        x:Class="DemaConsulting.CanvasPilot.SettingsSubsystem.SettingsDialogView"
        x:DataType="vm:SettingsDialogViewModel"
        Title="{Binding Title}"
        Icon="avares://DemaConsulting.CanvasPilot/Assets/Icon.png"
        Width="760"
        Height="520"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto,Auto" Margin="12">

    <Grid Grid.Row="0" ColumnDefinitions="180,12,*">
      <ListBox Grid.Column="0"
               AutomationProperties.AutomationId="SettingsPageList"
               ItemsSource="{Binding Pages}"
               SelectedItem="{Binding SelectedPage}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ISettingsPage">
            <TextBlock Text="{Binding Title}" Margin="4,2" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ContentControl Grid.Column="2"
                      AutomationProperties.AutomationId="SettingsPageContent"
                      Content="{Binding SelectedPage}" />
    </Grid>

    <TextBlock Grid.Row="1"
               Margin="0,8,0,0"
               AutomationProperties.AutomationId="SettingsErrorMessage"
               Foreground="Firebrick"
               TextWrapping="Wrap"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{Binding ErrorMessage}" />

    <StackPanel Grid.Row="2"
                Margin="0,12,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button AutomationProperties.AutomationId="SettingsOkButton"
              Content="OK"
              IsDefault="True"
              MinWidth="80"
              Command="{Binding OkCommand}" />
      <Button AutomationProperties.AutomationId="SettingsCancelButton"
              Content="Cancel"
              IsCancel="True"
              MinWidth="80"
              Command="{Binding CancelCommand}" />
      <Button AutomationProperties.AutomationId="SettingsApplyButton"
              Content="Apply"
              MinWidth="80"
              Command="{Binding ApplyCommand}" />
    </StackPanel>

  </Grid>

</Window>
