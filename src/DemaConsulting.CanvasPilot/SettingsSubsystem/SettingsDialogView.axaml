<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemaConsulting.CanvasPilot.SettingsSubsystem"
        x:Class="DemaConsulting.CanvasPilot.SettingsSubsystem.SettingsDialogView"
        x:DataType="vm:SettingsDialogViewModel"
        Title="{Binding Title}"
        Icon="avares://DemaConsulting.CanvasPilot/Assets/Icon.png"
        Width="860"
        Height="620"
        MinWidth="640"
        MinHeight="420"
        Background="{DynamicResource CpSurfacePane}"
        WindowStartupLocation="CenterOwner">

  <!-- The settings: a rail of pages on the left, the chosen page on the right under its title and a sentence about it, and a
       footer bar with the buttons and, when an entry cannot be applied, the reason in a banner. -->
  <Grid RowDefinitions="*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="200,*">

      <Border Grid.Column="0"
              Padding="12"
              Background="{DynamicResource CpSurfaceWindow}"
              BorderBrush="{DynamicResource CpBorderSubtle}"
              BorderThickness="0,0,1,0">
        <ListBox Classes="rail"
                 AutomationProperties.AutomationId="SettingsPageList"
                 AutomationProperties.Name="Settings pages"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage}">
          <ListBox.Styles>
            <!-- A row is announced by the title of its page, not by the type name of the page's view model -->
            <Style Selector="ListBoxItem" x:DataType="vm:ISettingsPage">
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ISettingsPage">
              <Grid ColumnDefinitions="3,Auto,*" ColumnSpacing="10">
                <Border Grid.Column="0"
                        Width="3"
                        Height="16"
                        Margin="-10,0,0,0"
                        CornerRadius="2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CpAccent}"
                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                <PathIcon Classes="icon"
                          Grid.Column="1"
                          Data="{Binding IconKey, Converter={x:Static vm:IconKeyConverter.Instance}}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource CpFontBody}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Title}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Grid Grid.Column="1"
            RowDefinitions="Auto,*"
            Margin="32,24,32,0">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
          <TextBlock Classes="pageTitle"
                     AutomationProperties.AutomationId="SettingsPageTitle"
                     Text="{Binding SelectedPage.Title}" />
          <TextBlock Classes="hint"
                     AutomationProperties.AutomationId="SettingsPageDescription"
                     FontSize="{DynamicResource CpFontBody}"
                     IsVisible="{Binding SelectedPage.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding SelectedPage.Description}" />
        </StackPanel>
        <ContentControl Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="SettingsPageContent"
                        Content="{Binding SelectedPage}" />
      </Grid>

    </Grid>

    <Border Grid.Row="1"
            Padding="24,12"
            Background="{DynamicResource CpSurfaceWindow}"
            BorderBrush="{DynamicResource CpBorderSubtle}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">

        <Border Grid.Column="0"
                Classes="bannerDanger"
                VerticalAlignment="Center"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Classes="icon"
                      VerticalAlignment="Top"
                      Margin="0,2,0,0"
                      Foreground="{DynamicResource CpDanger}"
                      Data="{DynamicResource CpIconErrorCircle}" />
            <TextBlock AutomationProperties.AutomationId="SettingsErrorMessage"
                       FontSize="{DynamicResource CpFontSmall}"
                       Foreground="{DynamicResource CpTextPrimary}"
                       TextWrapping="Wrap"
                       Text="{Binding ErrorMessage}" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
          <Button AutomationProperties.AutomationId="SettingsOkButton"
                  Theme="{DynamicResource PrimaryButton}"
                  Content="OK"
                  IsDefault="True"
                  MinWidth="88"
                  Command="{Binding OkCommand}" />
          <Button AutomationProperties.AutomationId="SettingsCancelButton"
                  Theme="{DynamicResource SecondaryButton}"
                  Content="Cancel"
                  IsCancel="True"
                  MinWidth="88"
                  Command="{Binding CancelCommand}" />
          <Button AutomationProperties.AutomationId="SettingsApplyButton"
                  Theme="{DynamicResource SecondaryButton}"
                  Content="Apply"
                  MinWidth="88"
                  Command="{Binding ApplyCommand}" />
        </StackPanel>

      </Grid>
    </Border>

  </Grid>

</Window>
