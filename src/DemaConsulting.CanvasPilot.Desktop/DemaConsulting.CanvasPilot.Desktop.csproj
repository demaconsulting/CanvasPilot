<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CanvasPilot</AssemblyName>
    <RootNamespace>DemaConsulting.CanvasPilot.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds the CanvasPilot sparkle icon (the repository-root Icon.ico, drawn from Icon.svg by
         render-icon.ps1) as the Windows executable's icon (exe icon, taskbar, Start Menu shortcut,
         Explorer). Only meaningful on win-x64 publishes; the SDK silently ignores it on other RIDs. -->
    <ApplicationIcon>..\..\Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DemaConsulting.CanvasPilot\DemaConsulting.CanvasPilot.csproj" />
  </ItemGroup>

</Project>
