<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DemaConsulting.CanvasPilot.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Implicit Usings -->
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Test Framework Dependencies -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DemaConsulting.CanvasPilot\DemaConsulting.CanvasPilot.csproj" />
  </ItemGroup>

  <!-- Expected texts that tests compare with what the code writes -->
  <ItemGroup>
    <None Include="StyleSubsystem\Golden\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Makes the test projects run one after the other when `dotnet test` starts their hosts together -->
  <ItemGroup>
    <Compile Include="..\SerializedTestRun.cs" Link="SerializedTestRun.cs" />
  </ItemGroup>

</Project>
