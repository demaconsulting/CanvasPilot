<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>OtsSoftwareTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <!-- Referenced directly only so that the Copilot SDK build props flow into this project: they carry the version
         of the Copilot CLI that the SDK is built for, which the OTS tests compare with CanvasPilot's minimum. -->
    <PackageReference Include="Microsoft.Copilot.SDK" Version="2.0.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The Copilot CLI version that the Copilot SDK is built for, read by the OTS tests of the SDK from the assembly. -->
    <AssemblyMetadata Include="CopilotCliVersion" Value="$(CopilotCliVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- A small help card that the tests of the CanvasNet help catalog add to the library cards, in the layout that
         the catalog reads from an assembly. WithCulture="false" keeps MSBuild from reading a dotted name as a
         satellite-resource culture. -->
    <EmbeddedResource Include="HelpCards\*.md" WithCulture="false"
                      LogicalName="OtsSoftwareTests.HelpCards/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DemaConsulting.CanvasPilot\DemaConsulting.CanvasPilot.csproj" />
  </ItemGroup>

  <!-- Makes the test projects run one after the other when `dotnet test` starts their hosts together -->
  <ItemGroup>
    <Compile Include="..\SerializedTestRun.cs" Link="SerializedTestRun.cs" />
  </ItemGroup>

</Project>
