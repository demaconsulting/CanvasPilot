<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>OtsSoftwareTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.2.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.2.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- A small help card that the tests of the CanvasNet help catalog add to the library cards, in the layout that
         the catalog reads from an assembly. WithCulture="false" keeps MSBuild from reading a dotted name as a
         satellite-resource culture. -->
    <EmbeddedResource Include="HelpCards\*.md" WithCulture="false"
                      LogicalName="OtsSoftwareTests.HelpCards/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The application brings the OTS items under test. The Copilot SDK is not referenced directly: it comes
       transitively through the application's AgentKit Copilot package, so the OTS tests of the Copilot SDK test the
       version that the application ships. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DemaConsulting.CanvasPilot\DemaConsulting.CanvasPilot.csproj" />
  </ItemGroup>

  <!-- Makes the test projects run one after the other when `dotnet test` starts their hosts together -->
  <ItemGroup>
    <Compile Include="..\SerializedTestRun.cs" Link="SerializedTestRun.cs" />
  </ItemGroup>

</Project>
