<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DemaConsulting.CanvasPilot.UiTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.2.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.2.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DemaConsulting.CanvasPilot\DemaConsulting.CanvasPilot.csproj" />
  </ItemGroup>

  <!-- The picture that the copilot drew for the README screenshot of the main window: project content, shown by the opt-in screenshot tests -->
  <ItemGroup>
    <EmbeddedResource Include="ScreenshotData\crazy-monkey-robot.svg" LogicalName="ScreenshotData.crazy-monkey-robot.svg" />
  </ItemGroup>

  <!-- Makes the test projects run one after the other when `dotnet test` starts their hosts together -->
  <ItemGroup>
    <Compile Include="..\SerializedTestRun.cs" Link="SerializedTestRun.cs" />
  </ItemGroup>

</Project>
