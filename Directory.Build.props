<Project>

  <!--
    Central MSBuild configuration shared by every project in the solution.

    This file exists so each project does not need to repeat the same compiler-strictness,
    documentation, and code-analysis settings; individual project files only declare their own
    target framework, package references, and output type.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>

    <!-- Code Quality Configuration -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- The Microsoft.Copilot.SDK package, which the AgentKit Copilot package brings, downloads and bundles its own
         GitHub Copilot runtime (a native copilot-runtime wrapper, runtime.node, and a CLI of about 180 MB) into the
         output of every project that references it, directly or transitively. CanvasPilot must not ship or download
         that runtime: it runs only the Copilot CLI that the user installed, which AgentKit uses by default (the
         installed-CLI source, at the full path that CanvasPilot names) and CanvasPilot never asks for the bundled
         source. Setting the property here, and not in one project, makes every project of the solution (application,
         executable, and the test projects) skip the download. The packaging guard in .fileassert.yaml and the OTS tests
         fail when a Copilot runtime appears. -->
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>

  <!-- Code Analysis Dependencies (C# projects only, so non-C# projects such as the installer are unaffected) -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.404">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.37.0.15768">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
